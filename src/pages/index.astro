---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopBar from "../components/TopBar.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import TrustBar from "../components/TrustBar.astro";
import TargetGroups from "../components/TargetGroups.astro";
import ProblemCheck from "../components/ProblemCheck.astro";
import InspectionScope from "../components/InspectionScope.astro";
import Services from "../components/Services.astro";
import Benefits from "../components/Benefits.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import ProtocolPreview from "../components/ProtocolPreview.astro";
import CaseStudy from "../components/CaseStudy.astro";
import Testimonials from "../components/Testimonials.astro";
import Pricing from "../components/Pricing.astro";
import AboutService from "../components/AboutService.astro";
import ActionReasons from "../components/ActionReasons.astro";
import BerlinDistricts from "../components/BerlinDistricts.astro";
import FAQ from "../components/FAQ.astro";
import QuoteForm from "../components/QuoteForm.astro";
import Footer from "../components/Footer.astro";
import IntroZo from '@/components/home/IntroZo.astro';
---

<BaseLayout
  title="Rauchmelder-Service Berlin für Vermieter | Rauchmelder Express"
  description="Prüfung, Montage und Austausch von Rauchwarnmeldern für Vermieter und Hausverwaltungen in Berlin – inklusive digitalem Prüfprotokoll."
>
  <TopBar />
  <Header />
  <main id="main" data-ps="src/pages/index.astro:c51a9c">
    <Hero />
    <TrustBar />
    <TargetGroups />
    <Services />
    <InspectionScope />
    <BerlinDistricts />
    <Benefits />
    <ProcessSteps />
    <ProtocolPreview />
    <ProblemCheck />
    <CaseStudy />
    <Testimonials />
    <Pricing />
    <AboutService />
    <ActionReasons />
    <FAQ />
    <QuoteForm />
  </main>
  <Footer />
  <IntroZo />
</BaseLayout>
