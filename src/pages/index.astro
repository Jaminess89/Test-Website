import { SITE } from '@/config/site';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Elektroprüfung | DGUV V3 Prüfung Berlin",
  "description": "DGUV V3 Prüfung in Berlin: Wir prüfen Ihre Geräte & Anlagen nach DGUV Vorschrift 3 (BGV A3). Zertifizierter Fachbetrieb mit Prüfprotokoll & Prüfplakette.",
  "url": SITE.url,
  "telephone": "+493020007607",
  "areaServed": [
    "Berlin",
    "Berlin-Mitte",
    "Friedrichshain-Kreuzberg",
    "Pankow",
    "Charlottenburg-Wilmersdorf",
    "Spandau",
    "Steglitz-Zehlendorf",
    "Tempelhof-Schöneberg",
    "Neukölln",
    "Treptow-Köpenick",
    "Marzahn-Hellersdorf",
    "Lichtenberg",
    "Reinickendorf"
  ]
};
---

<BaseLayout
  title="DGUV V3 Prüfung Berlin | E-Check nach VDE · BGV A3 | Elektroprüfung"
  description="DGUV V3 Prüfung in Berlin vom zertifizierten Fachbetrieb: Wir prüfen Ihre Geräte & Anlagen nach DGUV Vorschrift 3, mit Prüfprotokoll & Prüfplakette. Jetzt unverbindliches Angebot anfordern."
  jsonLd={jsonLd}
>
  <HeroSection />
  <TrustStrip />
  <ReviewsSection />
  <SectionNav />
  <DutySection />
  <RisksSection />
  <AdvantagesSection />
  <AboutSection />
  <VdeSection />
  <ScopeSection />
  <IntervalsSection />
  <QualificationSection />
  <InspectionSection />
  <WhyUsSection />
  <OfferSection />
  <ProcessSection />
