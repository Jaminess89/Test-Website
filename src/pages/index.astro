import ReviewsSection from '@/components/home/v2/ReviewsSection.astro';
import SectionNav from '@/components/home/v2/SectionNav.astro';
import DutySection from '@/components/home/v2/DutySection.astro';
import RisksSection from '@/components/home/v2/RisksSection.astro';
import AdvantagesSection from '@/components/home/v2/AdvantagesSection.astro';
