---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import TrustBar from '@/components/home/TrustBar.astro';
import Intro from '@/components/home/Intro.astro';
import PricePromise from '@/components/home/PricePromise.astro';
import ServiceSlider from '@/components/home/ServiceSlider.astro';
import FaqAccordion from '@/components/home/FaqAccordion.astro';
import PriceList from '@/components/home/PriceList.astro';
import { SITE } from '@/config/site';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Schlüsseldienst München 24Std.",
  "image": "https://pagesmith-cdn.com/ceb8c319/images/schluesseldienst-muenchen-start-1024.webp",
  "url": SITE.url,
  "telephone": "+4915735981964",
  "priceRange": "€€",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Woferlstraße 5",
    "addressLocality": "München",
    "postalCode": "81737",
    "addressCountry": "DE"
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday"
    ],
    "opens": "00:00",
    "closes": "23:59"
  }
};
---

<BaseLayout 
  title={SITE.title} 
  description={SITE.description}
  jsonLd={jsonLd}
>
  <Hero />
  <TrustBar />
  <Intro />
  <PricePromise />
  <ServiceSlider />
  <PriceList />
  <FaqAccordion />
</BaseLayout>
