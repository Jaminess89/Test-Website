---
import { about } from "../data/site";
import Container from "./ui/Container.astro";
import SectionHeading from "./ui/SectionHeading.astro";
import CheckList from "./ui/CheckList.astro";
import PictureFrame from "./ui/PictureFrame.astro";
---

<section class="section" id="ueber-uns">
  <Container>
    <SectionHeading
      overline="Persönlich und regional"
      title="Wer hinter Rauchmelder Express steht"
    />
    <div class="layout">
      {/* TODO: Platzhalter durch echtes Porträtfoto ersetzen (siehe README) */}
      <PictureFrame
        src="/images/service-technician-placeholder.svg"
        alt="Servicetechniker von Rauchmelder Express mit Klemmbrett in einem Treppenhaus"
        width={720}
        height={540}
        ratio="4 / 3"
      />
      <div class="content">
        <p class="content__name">{about.name}</p>
        <p class="content__role">{about.role}</p>
        <p class="content__intro">{about.intro}</p>
        <CheckList items={about.points} />
      </div>
    </div>
  </Container>
</section>

<style>
  .section {
    padding-block: var(--section-space);
    background: var(--color-surface-blue);
    border-block: 1px solid var(--color-border);
  }

  .layout {
    display: grid;
    gap: 2rem;
    align-items: center;
    max-width: 60rem;
    margin-inline: auto;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .content__name {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-navy-900);
  }

  .content__role {
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold-600);
    margin-block-end: 0.5rem;
  }

  .content__intro {
    color: var(--color-text-muted);
    margin-block-end: 0.75rem;
  }

  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }
</style>
