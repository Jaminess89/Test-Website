---
import { districts } from "../data/site";
import Container from "./ui/Container.astro";
import SectionHeading from "./ui/SectionHeading.astro";
import Icon from "./ui/Icon.astro";
---

<section class="section" id="bezirke" data-ps="src/components/BerlinDistricts.astro:w3dbw9">
  <Container>
    <SectionHeading
      overline="Regional in Berlin"
      title="Direkt in Ihrem Bezirk"
      lead="Bezirk auswählen und Anfrage starten."
    />
    <ul class="grid" role="list" data-district-grid>
      {
        districts.map((district, __psIdx) => (
          <li data-ps={`src/components/BerlinDistricts.astro:tbz2q7-${__psIdx}`}>
            <button
              type="button"
              class="card"
              data-district={district}
              aria-describedby="district-hint"
             data-ps={`src/components/BerlinDistricts.astro:6pkefm-${__psIdx}`}>
              <span class="card__icon" data-ps={`src/components/BerlinDistricts.astro:3tse25-${__psIdx}`}>
                <Icon name="map-pin" size={20} />
              </span>
              <span class="card__name" data-ps={`src/components/BerlinDistricts.astro:3tse24-${__psIdx}`}>{district}</span>
              <span class="card__arrow" data-ps={`src/components/BerlinDistricts.astro:3tse23-${__psIdx}`}>
                <Icon name="arrow-right" size={18} />
              </span>
            </button>
          </li>
        ))
      }
    </ul>
    <p class="visually-hidden" id="district-hint" data-ps="src/components/BerlinDistricts.astro:emgrtc">
      Wählt den Bezirk im Anfrageformular aus und springt zum Formular.
    </p>
  </Container>
</section>

<script>
  const grid = document.querySelector<HTMLElement>("[data-district-grid]");

  grid?.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-district]");
    if (!button) return;

    const district = button.dataset.district;
    const select = document.getElementById("bezirk") as HTMLSelectElement | null;

    if (select && district) {
      select.value = district;
      select.dispatchEvent(new Event("change", { bubbles: true }));
    }

    document.getElementById("angebot")?.scrollIntoView({ behavior: "smooth" });

    window.setTimeout(() => {
      const nextField = document.getElementById("plz") as HTMLInputElement | null;
      (nextField ?? select)?.focus({ preventScroll: true });
    }, 600);
  });
</script>

<style>
  .section {
    padding-block: var(--section-space);
    background: var(--color-ivory);
    border-block: 1px solid var(--color-border);
  }

  .grid {
    display: grid;
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    min-height: 56px;
    padding: 0.9rem 1.15rem;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-align: start;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .card:hover {
    border-color: var(--color-gold-500);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .card__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--color-blue-50);
    color: var(--color-blue-700);
  }

  .card__name {
    flex: 1;
    font-weight: 600;
    color: var(--color-navy-900);
  }

  .card__arrow {
    flex-shrink: 0;
    display: inline-flex;
    color: var(--color-gold-600);
    transition: transform 0.2s ease;
  }

  .card:hover .card__arrow {
    transform: translateX(3px);
  }

  @media (min-width: 560px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1150px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
