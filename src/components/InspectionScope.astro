---
import { inspectionItems } from "../data/site";
import Container from "./ui/Container.astro";
import SectionHeading from "./ui/SectionHeading.astro";
import Icon from "./ui/Icon.astro";
---

<section class="section" id="pruefung">
  <Container>
    <SectionHeading overline="Klare Leistung" title="Was wir kontrollieren" />
    <ul class="grid" role="list">
      {
        inspectionItems.map((item) => (
          <li class="item">
            <span class="item__icon">
              <Icon name={item.icon} size={22} />
            </span>
            <div>
              <h3 class="item__title">{item.title}</h3>
              {item.text && <p class="item__text">{item.text}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<style>
  .section {
    padding-block: var(--section-space);
    background: var(--color-white);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: 1rem;
    padding: 0;
    list-style: none;
  }

  .item {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    padding: 1.25rem 1.35rem;
    background: var(--color-blue-50);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .item__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: var(--radius);
    background: var(--color-white);
    border: 1px solid var(--color-border-premium);
    color: var(--color-blue-700);
  }

  .item__title {
    font-size: 1rem;
  }

  .item__text {
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }
</style>
