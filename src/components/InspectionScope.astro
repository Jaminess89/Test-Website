---
import { inspectionItems } from "../data/site";
import Container from "./ui/Container.astro";
import SectionHeading from "./ui/SectionHeading.astro";
import Icon from "./ui/Icon.astro";
---

<section class="section" id="pruefung" data-ps="src/components/InspectionScope.astro:4k9kt3">
  <Container>
    <div class="layout-split" data-ps="src/components/InspectionScope.astro:79welt">
      <div class="layout-content" data-ps="src/components/InspectionScope.astro:79wels">
        <SectionHeading overline="Klare Leistung" title="Was wir kontrollieren" />
        <ul class="grid-list" role="list">
          {
            inspectionItems.map((item, __psIdx) => (
              <li class="item" data-ps={`src/components/InspectionScope.astro:ydi4mj-${__psIdx}`}>
                <span class="item__icon" data-ps={`src/components/InspectionScope.astro:i7o8vq-${__psIdx}`}>
                  <Icon name={item.icon} size={22} />
                </span>
                <div data-ps={`src/components/InspectionScope.astro:79welq-${__psIdx}`}>
                  <h3 class="item__title" data-ps={`src/components/InspectionScope.astro:l4hsfc-${__psIdx}`}>{item.title}</h3>
                  {item.text && <p class="item__text" data-ps={`src/components/InspectionScope.astro:xzt27j-${__psIdx}`}>{item.text}</p>}
                </div>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="layout-image" data-ps="src/components/InspectionScope.astro:79welr">
        <img 
          src="https://pagesmith-cdn.com/ceb8c319/images/Bildschirmfoto-2026-07-26-um-12.41.09-1536-1536.webp" 
          alt="Rauchmelder Prüfung" 
          class="inspection-img" data-ps="src/components/InspectionScope.astro:xvyoq2" />
        <div class="image-fade" data-ps="src/components/InspectionScope.astro:79welq"></div>
      </div>
    </div>
  </Container>
</section>

<style>
  .section {
    padding-block: var(--section-space);
    background: var(--color-white);
  }

  .layout-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .layout-split {
      grid-template-columns: 1fr 1fr;
    }
  }

  .layout-content {
    position: relative;
    z-index: 2;
  }

  .grid-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    gap: 1rem;
    padding: 0;
    list-style: none;
    margin-top: 2rem;
  }

  .layout-image {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    min-height: 400px;
  }

  .inspection-img {
    width: 100%;
    height: auto;
    max-width: 600px;
    object-fit: contain;
    filter: drop-shadow(0 20px 40px rgba(0,0,0,0.05));
  }

  .image-fade {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, transparent 20%, var(--color-white) 80%);
    pointer-events: none;
  }

  @media (max-width: 1023px) {
    .layout-image {
      order: -1;
      min-height: 300px;
    }
    .image-fade {
      background: radial-gradient(circle at center, transparent 30%, var(--color-white) 90%);
    }
  }

  .item {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    padding: 1.25rem 1.35rem;
    background: var(--color-blue-50);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .item__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: var(--radius);
    background: var(--color-white);
    border: 1px solid var(--color-border-premium);
    color: var(--color-blue-700);
  }

  .item__title {
    font-size: 1rem;
  }

  .item__text {
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }
</style>
