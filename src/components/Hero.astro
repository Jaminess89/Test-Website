---
import { contact, cta } from "../data/site";
import Button from "./ui/Button.astro";
import Icon from "./ui/Icon.astro";
import PictureFrame from "./ui/PictureFrame.astro";

const heroBenefits = [
  "Mietertermine auf Wunsch koordiniert",
  "Dokumentation je Wohnung",
  "Transparentes Angebot vorab",
];
---

<section class="hero" id="start">
  <div class="hero__inner">
    <div class="hero__content">
      <p class="hero__label">Rauchmelder-Service Berlin</p>
      <h1 class="hero__title">
        Rauchmelder geprüft.<br />Nachweis vollständig.
      </h1>
      <p class="hero__text">
        Montage, Prüfung und Austausch für Vermieter – inklusive digitalem
        Prüfprotokoll für jede Wohnung.
      </p>
      <ul class="hero__benefits" role="list">
        {
          heroBenefits.map((benefit) => (
            <li>
              <span class="hero__check"><Icon name="check" size={14} /></span>
              {benefit}
            </li>
          ))
        }
      </ul>
      <div class="hero__actions">
        <Button href={cta.primaryHref} size="lg" arrow>{cta.primary}</Button>
        <a class="hero__phone" href={contact.phoneHref}>
          <Icon name="phone" size={18} />
          Persönlich beraten lassen
        </a>
      </div>
      <p class="hero__trust">Unverbindlich · regional · persönlich</p>
    </div>
    <div class="hero__media">
      {/* TODO: Platzhalter durch echtes Foto ersetzen (siehe README) */}
      <PictureFrame
        src="/images/hero-technician-placeholder.svg"
        alt="Servicetechniker von Rauchmelder Express prüft mit einem Tablet einen Rauchwarnmelder in einer hellen Mietwohnung"
        width={640}
        height={800}
        ratio="4 / 5"
        eager
      />
    </div>
  </div>
</section>

<style>
  .hero {
    background:
      linear-gradient(180deg, var(--color-blue-50) 0%, var(--color-ivory) 100%);
    border-block-end: 1px solid var(--color-border);
  }

  .hero__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    max-width: calc(var(--container-max) + 2 * var(--gutter));
    margin-inline: auto;
    padding: clamp(2.5rem, 6vw, 5rem) var(--gutter);
  }

  .hero__label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold-600);
    margin-block-end: 1.1rem;
  }

  .hero__label::before {
    content: "";
    width: 1.75rem;
    height: 2px;
    background: var(--color-gold-500);
  }

  .hero__title {
    margin-block-end: 1.25rem;
  }

  .hero__text {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    color: var(--color-text-muted);
    max-width: 34rem;
    margin-block-end: 1.5rem;
  }

  .hero__benefits {
    display: grid;
    gap: 0.55rem;
    padding: 0;
    margin-block-end: 1.9rem;
    list-style: none;
  }

  .hero__benefits li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-weight: 500;
  }

  .hero__check {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    background: var(--color-emerald-600);
    color: var(--color-white);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-block-end: 1.1rem;
  }

  .hero__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    color: var(--color-navy-900);
    font-weight: 600;
    text-decoration: none;
    border-block-end: 2px solid var(--color-gold-500);
  }

  .hero__phone:hover {
    color: var(--color-emerald-700);
  }

  .hero__trust {
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .hero__media {
    max-width: 34rem;
    width: 100%;
    margin-inline: auto;
  }

  @media (min-width: 960px) {
    .hero__inner {
      grid-template-columns: 1.05fr 0.95fr;
    }

    .hero__media {
      margin-inline: 0;
      justify-self: end;
    }
  }

  @media (max-width: 640px) {
    .hero__actions :global(.btn) {
      width: 100%;
    }

    .hero__phone {
      margin-inline: auto;
    }
  }
</style>
