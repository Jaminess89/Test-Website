---
---

<section class="mk-hero" aria-label="DGUV V3 Prüfung Berlin">
  <div class="mk-hero__inner">
    <div class="mk-hero__content">

      <h1>
        DGUV V3 Prüfung Berlin
        <span class="md:text-[40px]">E-Check nach VDE <b class="dot">·</b> BGV A3</span>
      </h1>

      <p class="mk-lead md:text-[18.8125px]">
        Wir prüfen Ihre Geräte &amp; Anlagen nach DGUV V3 für Berlin.<br>
        Zertifizierter Fachbetrieb mit Prüfprotokoll &amp; Prüfplakette.
      </p>

      <div class="mk-benefits">
        <div class="mk-benefit">
          <span class="mk-check-badge">✓</span>
          <span>DGUV-prüfberechtigter Fachbetrieb</span>
        </div>

        <div class="mk-benefit">
          <span class="mk-check-badge">✓</span>
          <span>Kurzfristige Termine</span>
        </div>
      </div>

      <div class="mk-actions">
        <a href="#angebot" class="mk-btn mk-btn--primary">
          <span>Unverbindliches Angebot</span>
          <span class="mk-arrow">→</span>
        </a>

        <a href="tel:+493020007607" class="mk-btn mk-btn--phone">
          <svg class="mk-phone-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 3h4l2 5-3 2c1 3 3 5 6 6l2-3 5 2v4c0 1-1 2-2 2C10 21 3 14 3 5c0-1 1-2 2-2Z"/>
          </svg>
          <span>030 20007607</span>
        </a>
      </div>

      <p class="mk-note">Erst mehr erfahren? <a href="#pflicht" class="text-[#8ef05a] font-bold underline decoration-2 underline-offset-4 hover:text-white transition-colors">Zur DGUV V3 Pflicht ↓</a></p>

    </div>

    <div class="mk-hero__visual" aria-hidden="true">
      <div class="mk-hero__card">
        <img
          src="/images/dguv/ECHECK1.png"
          width="228"
          height="228"
          alt="E-Check Prüfsiegel"
          class="mk-hero__card-img"
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
        <div class="mk-hero__card-text">
          <b>DGUV V3</b>
          <span>Elektroprüfung für Berlin</span>
        </div>
      </div>
      <div class="mk-hero__badge">
        <img src="/images/dguv/Purfsiegel-Prufplakette-1.png" width="206" height="206" alt="" loading="eager" decoding="async" />
        <span>Prüfplakette<br />inklusive</span>
      </div>
    </div>
  </div>
</section>

<style>
  .mk-hero {
    position: relative;
    overflow: hidden;
    background-color: #06263f;
    background-image:
      linear-gradient(180deg, rgba(3, 22, 39, 0) 55%, rgba(3, 22, 39, 0.9) 100%),
      linear-gradient(100deg, rgba(4, 24, 43, 0.94) 0%, rgba(6, 38, 63, 0.86) 45%, rgba(6, 43, 74, 0.6) 100%),
      url('/images/hero-bg.webp');
    background-image:
      linear-gradient(180deg, rgba(3, 22, 39, 0) 55%, rgba(3, 22, 39, 0.9) 100%),
      linear-gradient(100deg, rgba(4, 24, 43, 0.94) 0%, rgba(6, 38, 63, 0.86) 45%, rgba(6, 43, 74, 0.6) 100%),
      image-set(url('/images/hero-bg.avif') type('image/avif'), url('/images/hero-bg.webp') type('image/webp'));
    background-size: auto, auto, cover;
    background-position: center, center, center 30%;
    background-repeat: no-repeat;
    padding-top: 68px;
    font-family: var(--font-sans, sans-serif);
    color: #fff;
  }

  .mk-hero__inner {
    position: relative;
    z-index: 2;
    max-width: 1500px;
    margin-inline: auto;
    padding-inline: 20px;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 40px;
    align-items: center;
    min-height: 620px;
  }

  @media (min-width: 768px) {
    .mk-hero__inner { padding-inline: 60px; }
  }
  @media (min-width: 1280px) {
    .mk-hero__inner { padding-inline: 115px; }
  }

  .mk-hero__content {
    max-width: 720px;
    padding: 40px 0 60px;
  }

  .mk-hero h1 {
    margin: 0;
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 900;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: #fff;
  }

  .mk-hero h1 span {
    display: block;
    margin-top: 14px;
    font-size: clamp(22px, 2.6vw, 34px);
    font-weight: 900;
    letter-spacing: -0.015em;
    color: #8ef05a;
  }

  .mk-hero h1 .dot {
    color: rgba(255,255,255,0.5);
    font-weight: 900;
  }

  .mk-lead {
    margin-top: 22px;
    font-size: 17px;
    line-height: 1.55;
    color: #c7d6e2;
    font-weight: 600;
  }

  .mk-benefits {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .mk-benefit {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 6px 16px 6px 8px;
    border-radius: 999px;
    background: rgba(18, 60, 92, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(8px);
    font-size: 14.5px;
    font-weight: 700;
    color: #eaf2f8;
  }

  .mk-check-badge {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    flex-basis: 26px;
    border-radius: 50%;
    background: linear-gradient(180deg, #7ee84d, #2fae3f);
    color: #06210f;
    font-size: 15px;
    font-weight: 900;
    box-shadow: 0 2px 8px rgba(82, 206, 27, 0.45);
  }

  .mk-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .mk-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-width: 240px;
    min-height: 56px;
    padding: 0 26px;
    border-radius: 14px;
    font-size: 17px;
    font-weight: 900;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }

  .mk-btn--primary {
    color: #fff;
    background: linear-gradient(135deg, #3ddc4e, #12af42);
    border: 1px solid rgba(142, 240, 90, 0.6);
    box-shadow: 0 14px 30px rgba(82, 206, 27, 0.32);
  }

  .mk-btn--primary .mk-arrow {
    font-size: 24px;
    line-height: 1;
    transform: translateY(-1px);
    transition: transform 0.18s ease;
  }

  .mk-btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 36px rgba(82, 206, 27, 0.45);
  }

  .mk-btn--primary:hover .mk-arrow {
    transform: translate(4px, -1px);
  }

  .mk-btn--phone {
    min-width: 240px;
    color: #fff;
    background: rgba(20, 58, 86, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(10px);
  }

  .mk-hero__visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 40px 0;
  }

  .mk-hero__card {
    width: 380px;
    border-radius: 24px;
    padding: 26px;
    background: linear-gradient(160deg, rgba(30, 80, 120, 0.55), rgba(10, 40, 66, 0.7));
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(10px);
    text-align: center;
  }

  .mk-hero__card-img {
    width: 228px;
    height: auto;
    margin: 0 auto;
    display: block;
    filter: drop-shadow(0 10px 20px rgba(0, 0, 0, 0.35));
  }

  .mk-hero__card-text {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--font-heading, sans-serif);
  }

  .mk-hero__card-text b {
    font-size: 26px;
    font-weight: 900;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .mk-hero__card-text span {
    font-size: 14px;
    font-weight: 700;
    color: #9fc6dd;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .mk-hero__badge {
    position: absolute;
    bottom: 6%;
    left: -4%;
    width: 170px;
    padding: 14px 12px 12px;
    border-radius: 18px;
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.05));
    border: 1px solid rgba(255, 255, 255, 0.25);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(12px);
    text-align: center;
    animation: floaty 5s ease-in-out infinite;
  }

  .mk-hero__badge img {
    width: 96px;
    height: auto;
    display: block;
    margin: 0 auto 8px;
  }

  .mk-hero__badge span {
    font-size: 13px;
    font-weight: 800;
    line-height: 1.3;
    color: #dff3d2;
  }

  @keyframes floaty {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }

  @media (max-width: 1023px) {
    .mk-hero__inner {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: 10px;
    }

    .mk-hero__visual {
      padding: 10px 0 70px;
    }

    .mk-hero__badge {
      left: 4%;
      bottom: 0;
    }
  }

  @media (max-width: 640px) {
    .mk-hero__inner {
      min-height: auto;
    }

    .mk-hero__content {
      padding: 26px 0 10px;
    }

    .mk-btn {
      width: 100%;
      max-width: 400px;
      min-width: 0;
    }

    .mk-note {
      text-align: center;
    }

    .mk-hero__card {
      width: 300px;
    }

    .mk-hero__badge {
      width: 140px;
    }
  }
  .mk-btn--phone:hover {
    background: rgba(30, 75, 108, 0.95);
    border-color: rgba(255, 255, 255, 0.38);
    transform: translateY(-2px);
  }

  .mk-phone-svg {
    width: 22px;
    height: 22px;
    color: #8ef05a;
    flex-shrink: 0;
  }

  .mk-note {
    margin: 16px 0 0 8px;
    font-size: 15px;
    font-weight: 600;
    color: #b0c2d0;
  }
</style>
