---
import Container from '@/components/Container.astro';

const laws = [
  { label: 'BetrSichV §10', sub: 'Betriebssicherheitsverordnung' },
  { label: 'DGUV Vorschrift 3 (§5)', sub: 'Unfallverhütungsvorschrift' },
  { label: 'ArbSchG §3 Abs. 1', sub: 'Arbeitsschutzgesetz' },
];
---

<section id="pflicht" class="w-full bg-white py-[70px] lg:py-[90px]">
  <Container>
    <div class="max-w-[880px] mx-auto text-center">
      <p class="text-[13px] font-extrabold uppercase tracking-[0.14em] text-[#2fae3f] mb-3">Gesetzliche Pflicht</p>
      <h2 class="font-heading text-[32px] sm:text-[38px] font-black text-[#062B4A] leading-[1.12] tracking-[-0.02em] mb-5">
        DGUV Vorschrift 3 Pflicht in Berlin?
      </h2>
      <p class="text-[16px] sm:text-[17px] text-[#33475b] leading-relaxed max-w-[720px] mx-auto mb-10">
        Alle Betriebe mit Beschäftigten, auch in Berlin, müssen eine DGUV Elektroprüfung durchführen lassen, um die Sicherheit ihrer Mitarbeitenden zu gewährleisten.
      </p>

      <div class="bg-[#fbfaf8] border border-[#e8e4dc] rounded-[20px] px-6 py-7 sm:px-9">
        <p class="text-[13px] font-extrabold uppercase tracking-[0.14em] text-[#5b6b7b] mb-5">Rechtsgrundlagen</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {laws.map((law) => (
            <div class="flex items-center gap-3.5 bg-white border border-[#e8e4dc] rounded-[14px] px-5 py-4 text-left">
              <span class="inline-grid place-items-center w-10 h-10 shrink-0 rounded-xl bg-[#062B4A] text-[#8ef05a] text-[19px] font-black" aria-hidden="true">§</span>
              <span>
                <span class="block text-[15px] font-extrabold text-[#062B4A] leading-tight">{law.label}</span>
                <span class="block text-[12.5px] font-semibold text-[#8a97a5] mt-0.5">{law.sub}</span>
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Container>
</section>
