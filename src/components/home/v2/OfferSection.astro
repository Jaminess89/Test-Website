---
import Container from '@/components/Container.astro';
---

<section id="angebot" class="w-full bg-gradient-to-b from-[#06263f] to-[#031627] py-[70px] lg:py-[100px] text-white overflow-hidden">
  <Container>
    <div class="max-w-[860px] mx-auto">

      <div class="text-center mb-10">
        <p class="text-[13px] font-extrabold uppercase tracking-[0.14em] text-[#8ef05a] mb-3">Kontakt</p>
        <h2 class="font-heading text-[32px] sm:text-[40px] font-black leading-[1.12] tracking-[-0.02em] mb-4">
          Unverbindliches Angebot
        </h2>
        <p class="text-[16px] text-[#b9c9d6] leading-relaxed max-w-[640px] mx-auto">
          Wir sind bereit, wenn Sie es sind. Kontaktieren Sie uns noch heute für ein unverbindliches Angebot. Wir freuen uns auf Ihre Anfrage.
        </p>
      </div>

      <div class="card bg-white rounded-[24px] shadow-[0_30px_80px_rgba(0,0,0,0.45)] p-7 sm:p-10 text-[#1c2f41]">
        <form id="offer-form" novalidate>
          {/* Honeypot gegen Spam-Bots (für Menschen unsichtbar, nicht ausfüllen) */}
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute left-[-9999px] w-px h-px opacity-0" />
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-5">
            <div>
              <label for="of-name" class="block text-[13px] font-extrabold uppercase tracking-wide text-[#33475b] mb-1.5">Name <span class="text-[#e11d48]">*</span></label>
              <input id="of-name" name="name" type="text" required autocomplete="name" placeholder="Ihr Name"
                class="w-full rounded-[12px] border border-[#d7dde4] bg-[#fbfaf8] px-4 py-3 text-[15px] font-semibold text-[#1c2f41] placeholder:text-[#9aa7b4] focus:outline-none focus:ring-2 focus:ring-[#2fae3f] focus:border-transparent" />
            </div>
            <div>
              <label for="of-phone" class="block text-[13px] font-extrabold uppercase tracking-wide text-[#33475b] mb-1.5">Telefon <span class="text-[#e11d48]">*</span></label>
              <input id="of-phone" name="phone" type="tel" required autocomplete="tel" placeholder="Ihre Telefonnummer"
                class="w-full rounded-[12px] border border-[#d7dde4] bg-[#fbfaf8] px-4 py-3 text-[15px] font-semibold text-[#1c2f41] placeholder:text-[#9aa7b4] focus:outline-none focus:ring-2 focus:ring-[#2fae3f] focus:border-transparent" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-5">
            <div>
              <label for="of-email" class="block text-[13px] font-extrabold uppercase tracking-wide text-[#33475b] mb-1.5">E-Mail <span class="text-[#e11d48]">*</span></label>
              <input id="of-email" name="email" type="email" required autocomplete="email" placeholder="ihre@email.de"
                class="w-full rounded-[12px] border border-[#d7dde4] bg-[#fbfaf8] px-4 py-3 text-[15px] font-semibold text-[#1c2f41] placeholder:text-[#9aa7b4] focus:outline-none focus:ring-2 focus:ring-[#2fae3f] focus:border-transparent" />
            </div>
            <div>
              <label for="of-plz" class="block text-[13px] font-extrabold uppercase tracking-wide text-[#33475b] mb-1.5">PLZ <span class="text-[#e11d48]">*</span></label>
              <input id="of-plz" name="plz" type="text" inputmode="numeric" required autocomplete="postal-code" placeholder="z. B. 10115"
                class="w-full rounded-[12px] border border-[#d7dde4] bg-[#fbfaf8] px-4 py-3 text-[15px] font-semibold text-[#1c2f41] placeholder:text-[#9aa7b4] focus:outline-none focus:ring-2 focus:ring-[#2fae3f] focus:border-transparent" />
            </div>
          </div>

          <div class="mb-5">
            <label for="of-message" class="block text-[13px] font-extrabold uppercase tracking-wide text-[#33475b] mb-1.5">Nachricht <span class="text-[#e11d48]">*</span></label>
            <textarea id="of-message" name="message" rows="5" required maxlength="8000" placeholder="Worum geht es? z. B. Anzahl der Geräte, Art des Betriebs …"
              class="w-full rounded-[12px] border border-[#d7dde4] bg-[#fbfaf8] px-4 py-3 text-[15px] font-semibold text-[#1c2f41] placeholder:text-[#9aa7b4] focus:outline-none focus:ring-2 focus:ring-[#2fae3f] focus:border-transparent resize-y"></textarea>
          </div>

          <div class="mb-6">
            <label class="flex items-start gap-3 cursor-pointer select-none">
              <input id="of-privacy" type="checkbox" required class="mt-1 w-4 h-4 accent-[#2fae3f] shrink-0" />
              <span class="text-[13.5px] font-semibold text-[#33475b] leading-snug">
                Ich stimme der Verarbeitung meiner Daten gemäß <a href="/datenschutzerklaerung/" class="text-[#1c7c2e] underline">Datenschutzerklärung</a> zu. <span class="text-[#e11d48]">*</span>
              </span>
            </label>
          </div>

          <p id="of-error" class="hidden mb-4 text-[14px] font-bold text-[#e11d48]">Bitte füllen Sie alle Pflichtfelder aus und stimmen Sie der Datenverarbeitung zu.</p>

          <button type="submit"
            class="w-full inline-flex items-center justify-center gap-2 bg-gradient-to-br from-[#3ddc4e] to-[#12af42] text-white text-[17px] font-black px-8 py-4 rounded-[14px] shadow-[0_14px_30px_rgba(82,206,27,0.35)] hover:-translate-y-0.5 transition-transform cursor-pointer border-0">
            Unverbindliches Angebot anfordern <span aria-hidden="true">→</span>
          </button>

          <p class="text-center text-[12.5px] font-semibold text-[#8a97a5] mt-4 mb-0">100% unverbindlich &amp; kostenlos · Antwort i. d. R. innerhalb von 24h</p>
        </form>

        <div id="of-success" class="hidden text-center py-8">
          <span class="inline-grid place-items-center w-16 h-16 rounded-full bg-gradient-to-b from-[#7ee84d] to-[#2fae3f] text-[#06210f] text-[30px] font-black mb-5" aria-hidden="true">✓</span>
          <h3 class="font-heading text-[24px] font-black text-[#062B4A] mb-2">Vielen Dank für Ihre Anfrage!</h3>
          <p class="text-[15px] text-[#33475b] max-w-[440px] mx-auto">Wir melden uns in der Regel innerhalb von 24 Stunden bei Ihnen. Bei dringenden Fragen erreichen Sie uns unter <a href="tel:+493020007607" class="font-bold text-[#1c7c2e]">030 20007607</a>.</p>
        </div>
      </div>

      <!-- Direkter Telefonkontakt unter dem Formular -->
      <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-[620px] mx-auto">
        <a href="tel:+493020007607" class="flex items-center justify-center gap-3 rounded-[16px] border border-white/15 bg-white/[0.06] backdrop-blur-md px-6 py-4 no-underline hover:bg-white/[0.12] hover:-translate-y-0.5 transition-all shadow-[0_14px_34px_rgba(0,0,0,0.3)]">
          <svg class="w-5 h-5 text-[#8ef05a] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3h4l2 5-3 2c1 3 3 5 6 6l2-3 5 2v4c0 1-1 2-2 2C10 21 3 14 3 5c0-1 1-2 2-2Z"/></svg>
          <span class="text-[18px] font-black text-white tracking-tight whitespace-nowrap">030 20007607</span>
          <span class="text-[11px] font-extrabold uppercase tracking-[0.14em] text-[#8ef05a]">Büro</span>
        </a>
        <a href="tel:+491717495078" class="flex items-center justify-center gap-3 rounded-[16px] border border-white/15 bg-white/[0.06] backdrop-blur-md px-6 py-4 no-underline hover:bg-white/[0.12] hover:-translate-y-0.5 transition-all shadow-[0_14px_34px_rgba(0,0,0,0.3)]">
          <svg class="w-5 h-5 text-[#8ef05a] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3h4l2 5-3 2c1 3 3 5 6 6l2-3 5 2v4c0 1-1 2-2 2C10 21 3 14 3 5c0-1 1-2 2-2Z"/></svg>
          <span class="text-[18px] font-black text-white tracking-tight whitespace-nowrap">0171 749 5078</span>
          <span class="text-[11px] font-extrabold uppercase tracking-[0.14em] text-[#8ef05a]">Mobil</span>
        </a>
      </div>

    </div>
  </Container>
</section>

<script is:inline>
  const offerForm = document.getElementById('offer-form');
  const ofError = document.getElementById('of-error');
  const ofSuccess = document.getElementById('of-success');

  if (offerForm) {
    offerForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const required = offerForm.querySelectorAll('[required]');
      let valid = true;
      required.forEach((field) => {
        if (field.type === 'checkbox') {
          if (!field.checked) valid = false;
        } else if (!field.value.trim()) {
          valid = false;
        }
      });
      if (!valid) {
        if (ofError) {
          ofError.textContent = 'Bitte füllen Sie alle Pflichtfelder aus und stimmen Sie der Datenverarbeitung zu.';
          ofError.classList.remove('hidden');
        }
        return;
      }
      if (ofError) ofError.classList.add('hidden');

      const submitBtn = offerForm.querySelector('button[type="submit"]');
      const originalBtnContent = submitBtn ? submitBtn.innerHTML : '';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Wird gesendet …';
      }

      try {
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 20000);
        const res = await fetch('/sendmail.php', {
          method: 'POST',
          body: new FormData(offerForm),
          signal: controller.signal,
        });
        clearTimeout(timeoutId);
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error('send failed');
        offerForm.classList.add('hidden');
        if (ofSuccess) ofSuccess.classList.remove('hidden');
      } catch (err) {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalBtnContent;
        }
        if (ofError) {
          ofError.textContent = 'Die Anfrage konnte leider nicht gesendet werden. Bitte versuchen Sie es erneut oder rufen Sie uns direkt an: 030 20007607.';
          ofError.classList.remove('hidden');
        }
      }
    });
  }
</script>
