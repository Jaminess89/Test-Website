---
import Container from '@/components/Container.astro';

const risks = [
  {
    icon: 'warn',
    title: 'Haftung',
    text: 'Kommt es zu Unfällen oder Schäden und wird die fehlende DGUV Prüfung als Ursache ermittelt, können das Unternehmen und damit auch der Geschäftsführer direkt haftbar gemacht werden.',
  },
  {
    icon: 'ban',
    title: 'Stilllegung',
    text: 'Bei schweren oder wiederholten Verstößen kann die Behörde eine vorübergehende oder sogar dauerhafte Stilllegung des Betriebs anordnen.',
  },
  {
    icon: 'euro',
    title: 'Geldstrafen',
    text: 'Ein Besuch der Berufsgenossenschaft kann jederzeit unangekündigt erfolgen. Dann muss der Prüfstatus aller ortsveränderbaren Geräte nachweisbar sein, andernfalls drohen je nach Schwere der Verstöße Bußgelder.',
  },
  {
    icon: 'lock',
    title: 'Kein Versicherungsschutz',
    text: 'Kommt es zu einem Unfall und das Unternehmen ist nicht DGUV-geprüft, kann die Unfallversicherung die Zahlung verweigern. Die Schadenskosten bleiben dann am Betrieb hängen.',
  },
];
---

<section id="risiken" class="w-full bg-[#f7f5f1] py-[70px] lg:py-[90px]">
  <Container>
    <div class="max-w-[820px] mx-auto text-center mb-12 lg:mb-14">
      <p class="text-[13px] font-extrabold uppercase tracking-[0.14em] text-[#e11d48] mb-3">Risiken bei Nichtbeachtung</p>
      <h2 class="font-heading text-[32px] sm:text-[38px] font-black text-[#062B4A] leading-[1.12] tracking-[-0.02em] m-0">
        Risiken ohne E-Check
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {risks.map((risk) => (
        <div class="bg-white border border-[#f0d8dd] rounded-[18px] p-6 shadow-[0_6px_20px_rgba(6,43,74,0.05)] hover:shadow-[0_16px_40px_rgba(225,29,72,0.12)] hover:-translate-y-1 transition-all duration-300">
          <span class="block mb-5">
            {risk.icon === 'warn' && (
              <span class="risk-icon risk-icon--warn" aria-hidden="true"><span class="tri"></span><span class="mark">!</span></span>
            )}
            {risk.icon === 'ban' && (
              <span class="risk-icon risk-icon--ban" aria-hidden="true"></span>
            )}
            {risk.icon === 'euro' && (
              <span class="risk-icon risk-icon--euro" aria-hidden="true">€</span>
            )}
            {risk.icon === 'lock' && (
              <span class="risk-icon risk-icon--lock" aria-hidden="true"><span class="shackle"></span><span class="lockbody"></span></span>
            )}
          </span>
          <h3 class="font-heading text-[17px] font-black text-[#062B4A] mb-2 leading-snug">{risk.title}</h3>
          <p class="text-[14px] text-[#33475b] leading-relaxed m-0">{risk.text}</p>
        </div>
      ))}
    </div>
  </Container>
</section>

<style>
  /* Reine HTML/CSS-Icons (keine Bilder, keine Icon-Fonts) */
  .risk-icon {
    position: relative;
    display: inline-block;
    width: 46px;
    height: 46px;
  }

  /* 1. Warn-Dreieck - Haftung */
  .risk-icon--warn .tri {
    position: absolute;
    inset: 4px 2px 2px;
    background: linear-gradient(180deg, #f43f5e, #dc2648);
    clip-path: polygon(50% 0%, 100% 100%, 0% 100%);
  }
  .risk-icon--warn .mark {
    position: absolute;
    left: 50%;
    bottom: 7px;
    transform: translateX(-50%);
    color: #ffffff;
    font-size: 20px;
    font-weight: 900;
    line-height: 1;
  }

  /* 2. Durchgestrichener Kreis - Stilllegung */
  .risk-icon--ban {
    width: 42px;
    height: 42px;
    margin: 2px;
    border: 4px solid #e11d48;
    border-radius: 50%;
  }
  .risk-icon--ban::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 34px;
    height: 4px;
    background: #e11d48;
    border-radius: 2px;
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  /* 3. Euro-Zeichen - Geldstrafen */
  .risk-icon--euro {
    width: 42px;
    height: 42px;
    margin: 2px;
    border-radius: 50%;
    background: linear-gradient(180deg, #f43f5e, #dc2648);
    box-shadow: inset 0 2px 0 rgba(255, 255, 255, 0.28);
    color: #ffffff;
    font-size: 22px;
    font-weight: 900;
    display: inline-grid;
    place-items: center;
  }

  /* 4. Schloss - Kein Versicherungsschutz */
  .risk-icon--lock .shackle {
    position: absolute;
    left: 50%;
    top: 4px;
    transform: translateX(-50%);
    width: 20px;
    height: 16px;
    border: 4px solid #dc2648;
    border-bottom: 0;
    border-radius: 10px 10px 0 0;
  }
  .risk-icon--lock .lockbody {
    position: absolute;
    left: 50%;
    bottom: 3px;
    transform: translateX(-50%);
    width: 34px;
    height: 25px;
    background: linear-gradient(180deg, #f43f5e, #dc2648);
    border-radius: 6px;
  }
  .risk-icon--lock .lockbody::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 45%;
    transform: translate(-50%, -50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #ffffff;
  }
</style>
