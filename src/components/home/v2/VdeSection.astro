---
import Container from '@/components/Container.astro';

const terms = [
  {
    badge: 'VDE',
    title: 'Der Normen-Verband',
    text: 'VDE ist der Verband, der technische Normen (DIN VDE 0701-0702) für Elektro-Ausrüstung festlegt.',
  },
  {
    badge: 'BGV A3',
    title: 'Die frühere Vorschrift',
    text: 'BGV A3 war die frühere Vorschrift der Berufsgenossenschaften zur jährlichen Sicherheitsprüfung elektrischer Geräte und Anlagen. Seit 2013 heißt diese Prüfung DGUV V3, inhaltlich aber identisch zur alten BGV A3.',
  },
];
---

<section class="w-full bg-white py-[70px] lg:py-[90px]">
  <Container>
    <div class="text-center max-w-[760px] mx-auto mb-10 lg:mb-12">
      <p class="text-[13px] font-extrabold uppercase tracking-[0.14em] text-[#2fae3f] mb-3">Begriffe erklärt</p>
      <h2 class="font-heading text-[32px] sm:text-[38px] font-black text-[#062B4A] leading-[1.12] tracking-[-0.02em] m-0">
        Was ist VDE / BGV A3?
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-[980px] mx-auto">
      {terms.map((term) => (
        <div class="bg-[#fbfaf8] border border-[#e8e4dc] rounded-[18px] p-7 hover:shadow-[0_16px_40px_rgba(6,43,74,0.10)] hover:-translate-y-1 transition-all duration-300">
          <span class="inline-grid place-items-center h-10 px-4 rounded-xl bg-[#062B4A] text-[#8ef05a] text-[15px] font-black tracking-wide mb-4">{term.badge}</span>
          <h3 class="font-heading text-[17px] font-black text-[#062B4A] mb-2 leading-snug">{term.title}</h3>
          <p class="text-[14.5px] text-[#33475b] leading-relaxed m-0">{term.text}</p>
        </div>
      ))}
    </div>
  </Container>
</section>
