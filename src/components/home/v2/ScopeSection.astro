---
import Container from '@/components/Container.astro';

const scopes = [
  {
    title: 'Geräte (Ortsveränderlich)',
    text: 'Ortsveränderliche Geräte sind elektrische Arbeits- und Haushaltsmittel, die leicht transportiert und flexibel an verschiedenen Einsatzorten verwendet werden können, sei es im Büro, zu Hause oder auf der Baustelle.',
    examples: ['Büro: Laptop, Drucker, Bildschirm', 'Haushalt: Wasserkocher, Staubsauger', 'Werkstatt/Baustelle: Bohrmaschine, Stichsäge'],
    img: '/images/dguv/Ortsveranderbare-Gerate-.png',
    alt: 'Ortsveränderliche Geräte: DGUV V3 Prüfung',
  },
  {
    title: 'Anlagen (Ortsfest)',
    text: 'Ortsfeste Anlagen bestehen aus fest montierten, elektrisch verbundenen Komponenten, die dauerhaft an einem Ort installiert sind, etwa in Gebäuden oder technischen Einrichtungen.',
    examples: ['Stromverteilerschränke', 'Lüftungs- und Klimageräte', 'Beleuchtung (auch Notbeleuchtung)', 'Steckdoseninstallationen', 'Elektrische Türen und Tore'],
    img: '/images/dguv/Elektische-ortsfeste-Anlage.png',
    alt: 'Ortsfeste elektrische Anlagen: DGUV V3 Prüfung',
  },
  {
    title: 'Maschinen (Ortsfest)',
    text: 'Ortsfeste Maschinen sind stationäre Geräte, die fest verbaut oder aufgrund ihres Gewichts und ihrer Größe nicht ohne Weiteres bewegt werden können. Sie kommen vor allem in der Industrie, Produktion oder im gewerblichen Umfeld zum Einsatz.',
    examples: ['CNC-Fräsen, Sägen, Pressen', 'Spritzguss- und Druckmaschinen', 'Küchenmaschinen, Klimaanlagen'],
    img: '/images/dguv/Ortsfeste-elektische-Maschinen.png',
    alt: 'Ortsfeste Maschinen: DGUV V3 Prüfung',
  },
];
---

<section id="pruefumfang" class="w-full bg-[#f7f5f1] py-[70px] lg:py-[90px]">
  <Container>
    <div class="max-w-[860px] mx-auto text-center mb-12 lg:mb-14">
      <p class="text-[13px] font-extrabold uppercase tracking-[0.14em] text-[#2fae3f] mb-3">Prüfumfang</p>
      <h2 class="font-heading text-[32px] sm:text-[38px] font-black text-[#062B4A] leading-[1.12] tracking-[-0.02em] mb-5">
        Was muss man prüfen?
      </h2>
      <p class="text-[16px] text-[#33475b] leading-relaxed m-0">
        Kurz gesagt: Im Rahmen der DGUV-Prüfung wird alles überprüft, was potenziell elektrische Gefahren verursachen kann, also alle Geräte und Anlagen mit Netzanschluss, sei es über eine Steckdose oder eine feste Installation. In der Regel betrifft das Systeme mit Spannungen zwischen 230 und 400 Volt. Dazu gehören unter anderem:
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {scopes.map((scope) => (
        <div class="group bg-white border border-[#e8e4dc] rounded-[20px] overflow-hidden hover:shadow-[0_20px_50px_rgba(6,43,74,0.12)] hover:-translate-y-1 transition-all duration-300 flex flex-col">
          <div class="aspect-[3/2] overflow-hidden bg-[#eef2f6]">
            <img
              src={scope.img}
              alt={scope.alt}
              width="610"
              height="406"
              class="w-full h-full object-cover group-hover:scale-[1.04] transition-transform duration-500"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-6 flex flex-col flex-1">
            <h3 class="font-heading text-[18px] font-black text-[#062B4A] leading-snug mb-2">{scope.title}</h3>
            <p class="text-[14.5px] text-[#33475b] leading-relaxed mb-4">{scope.text}</p>
            <ul class="mt-auto space-y-2 pt-4 border-t border-[#eef0f3] list-none p-0">
              {scope.examples.map((example) => (
                <li class="flex items-start gap-2.5 text-[13.5px] font-semibold text-[#33475b] leading-snug">
                  <span class="mt-[3px] inline-block w-1.5 h-1.5 rounded-full bg-[#2fae3f] shrink-0" aria-hidden="true"></span>
                  {example}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </Container>
</section>
