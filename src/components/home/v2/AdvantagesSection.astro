---
import Container from '@/components/Container.astro';

const benefits = [
  {
    title: 'Stromkosten senken',
    text: 'Die DGUV-Prüfung deckt ineffiziente oder defekte ortsveränderliche Betriebsmittel auf. So reduzieren Sie Ihren Energieverbrauch und sparen dauerhaft Kosten.',
  },
  {
    title: 'Gerätelebensdauer verlängern',
    text: 'Frühzeitig erkannte Mängel durch regelmäßige Prüfungen ermöglichen schnelle Reparaturen und sorgen so für eine längere Nutzungsdauer Ihrer Geräte.',
  },
];
---

<section class="w-full bg-white py-[70px] lg:py-[90px]">
  <Container>
    <div class="max-w-[820px] mx-auto text-center mb-12 lg:mb-14">
      <p class="text-[13px] font-extrabold uppercase tracking-[0.14em] text-[#2fae3f] mb-3">Ihre Vorteile</p>
      <h2 class="font-heading text-[32px] sm:text-[38px] font-black text-[#062B4A] leading-[1.12] tracking-[-0.02em] m-0">
        Vorteile der Prüfung:
      </h2>
    </div>

    <ul class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-[980px] mx-auto list-none p-0 m-0">
      {benefits.map((benefit) => (
        <li class="flex items-start gap-4 bg-[#f2f9ee] border border-[#d9ecce] rounded-[18px] p-6 sm:p-7 hover:shadow-[0_16px_40px_rgba(47,174,63,0.14)] hover:-translate-y-1 transition-all duration-300">
          <span class="mt-0.5 inline-grid place-items-center w-9 h-9 shrink-0 rounded-full bg-gradient-to-b from-[#7ee84d] to-[#2fae3f] text-[#06210f] text-[17px] font-black shadow-[0_4px_12px_rgba(82,206,27,0.4)]" aria-hidden="true">✓</span>
          <span>
            <span class="block font-heading text-[17.5px] font-black text-[#062B4A] leading-snug mb-1.5">{benefit.title}</span>
            <span class="block text-[14.5px] text-[#33475b] leading-relaxed">{benefit.text}</span>
          </span>
        </li>
      ))}
    </ul>
  </Container>
</section>
