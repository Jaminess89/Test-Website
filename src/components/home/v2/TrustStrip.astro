---
const items = [
  { title: 'DGUV-prüfberechtigt', text: 'Elektrofachkräfte' },
  { title: 'Prüfprotokoll', text: '& Plakette inklusive' },
  { title: 'Kurzfristige Termine', text: 'ganz Berlin' },
  { title: '25 Jahre', text: 'Elektro-Erfahrung' },
];
---

<section class="w-full bg-[#041c33] border-t border-white/10 py-6">
  <div class="max-w-[1320px] mx-auto px-5">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
      {items.map((item) => (
        <div class="flex items-center gap-3 justify-center">
          <span class="inline-grid place-items-center w-8 h-8 shrink-0 rounded-full bg-gradient-to-b from-[#7ee84d] to-[#2fae3f] text-[#06210f] text-[15px] font-black shadow-[0_2px_8px_rgba(82,206,27,0.45)]" aria-hidden="true">✓</span>
          <span class="text-white/90 text-[13px] sm:text-[14px] font-bold leading-snug">
            {item.title}<br class="hidden sm:block" />
            <span class="font-semibold text-white/60">{item.text}</span>
          </span>
        </div>
      ))}
    </div>
  </div>
</section>