---
import Container from '@/components/Container.astro';
---

<section class="py-[52px] bg-gradient-to-r from-secondary to-accent" data-ps="src/components/home/PricePromise.astro:root">
  <Container class="text-center border border-white/20 py-8 rounded-lg">
    <h3 class="text-[24px] font-bold text-white mb-4 font-heading" data-ps="src/components/home/PricePromise.astro:h3">
      Unser faires Preisversprechen
    </h3>
    <p class="text-white text-[18px] max-w-3xl mx-auto px-6" data-ps="src/components/home/PricePromise.astro:x0ab0y">
      Sie werden vor Türöffnung über alle anfallenden Kosten informiert. Nur, wenn Sie mit dem Preis einverstanden sind, wird die Türöffnung in München durchgeführt.
    </p>
  </Container>
</section>
