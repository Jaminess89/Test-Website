---
import Container from '@/components/Container.astro';
---

<section class="bg-[#ECF0F1] py-[120px] overflow-hidden" data-ps="src/components/home/Hero.astro:g4bd0a">
  <Container class="flex flex-col md:flex-row items-center">
    <div class="w-full md:w-[55%] z-10" data-ps="src/components/home/Hero.astro:content">
      <h1 class="text-[64px] font-black text-foreground leading-[80px] mb-6 font-heading" data-ps="src/components/home/Hero.astro:h1">
        Schlüsseldienst<br/>München
      </h1>
      
      <div class="inline-block bg-secondary text-white px-4 py-2 rounded-sm font-bold mb-8" data-ps="src/components/home/Hero.astro:badge">
        Festpreis ab 29,- €
      </div>

      <ul class="space-y-4 mb-8 list-none p-0" data-ps="src/components/home/Hero.astro:bullets">
        <li class="flex items-center gap-3 text-[18px] text-foreground font-semibold" data-ps="src/components/home/Hero.astro:vq51in">
          <svg class="w-5 h-5 text-primary shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          in 10 – 40 Minuten vor Ort
        </li>
      </ul>

      <a href="tel:+4915735981964" class="inline-flex items-center gap-2 bg-primary hover:bg-[#69b02e] text-white px-[16px] py-[10px] rounded-[9px] text-[18px] font-bold no-underline transition-colors" data-ps="src/components/home/Hero.astro:cta">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
        </svg>
        0157 359 819 64 Jetzt anrufen!
      </a>
    </div>

    <div class="w-full md:w-[45%] mt-12 md:mt-0 relative" data-ps="src/components/home/Hero.astro:image">
      <img 
        src="https://pagesmith-cdn.com/ceb8c319/images/schluesseldienst-muenchen-start-1024.webp" 
        alt="Schlüsseldienst München Türöffnung" 
        class="w-full h-auto object-cover rounded-lg"
        loading="eager"
        fetchpriority="high" data-ps="src/components/home/Hero.astro:fibi7w" />
    </div>
  </Container>
</section>
