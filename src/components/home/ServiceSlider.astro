---
import Container from '@/components/Container.astro';
---

<section class="bg-dark-background py-[100px]" data-ps="src/components/home/ServiceSlider.astro:root">
  <Container>
    <h2 class="text-[48px] font-bold text-white mb-12 font-heading" data-ps="src/components/home/ServiceSlider.astro:h2">
      Schlosstausch und Zylindertausch durch den Schlüsseldienst München
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-[8%] items-start" data-ps="src/components/home/ServiceSlider.astro:ey8kcy">
      <div class="relative group" data-ps="src/components/home/ServiceSlider.astro:image-wrapper">
        <div class="absolute -top-[14px] -left-[14px] w-full h-full border-[14px] border-secondary -z-10" data-ps="src/components/home/ServiceSlider.astro:ey8kcx"></div>
        <div id="service-image-container" class="aspect-[522/530] overflow-hidden bg-white" data-ps="src/components/home/ServiceSlider.astro:ey8kcw">
          <img id="active-service-image" src="https://pagesmith-cdn.com/ceb8c319/images/schlosstausch-durch-schluesseldienst-e1619558370958-768.webp" alt="Einbau von Schloss" class="w-full h-full object-cover transition-opacity duration-500" data-ps="src/components/home/ServiceSlider.astro:q7miyx" />
        </div>
      </div>

      <div class="flex flex-col gap-4" data-ps="src/components/home/ServiceSlider.astro:tabs">
        <button class="service-tab text-left p-6 bg-white/5 border-l-4 border-secondary text-white transition-all hover:bg-white/10" data-image="https://pagesmith-cdn.com/ceb8c319/images/schlosstausch-durch-schluesseldienst-e1619558370958-768.webp" data-ps="src/components/home/ServiceSlider.astro:lhkiuj">
          <h3 class="text-[24px] font-bold mb-2" data-ps="src/components/home/ServiceSlider.astro:oeboz5">Türschloss wechseln</h3>
          <p class="text-dark-muted-foreground text-sm" data-ps="src/components/home/ServiceSlider.astro:izamwx">Ein verlorener Haustürschlüssel ist ein Sicherheitsrisiko. Lassen Sie daher schnellstmöglich das Türschloss austauschen.</p>
        </button>
        <button class="service-tab text-left p-6 bg-transparent border-l-4 border-transparent text-white/60 transition-all hover:bg-white/5" data-image="https://pagesmith-cdn.com/ceb8c319/images/schloss-tauschen-e1619558564919-768.webp" data-ps="src/components/home/ServiceSlider.astro:lhkiui">
          <h3 class="text-[24px] font-bold mb-2" data-ps="src/components/home/ServiceSlider.astro:oeboz6">Schloss austauschen</h3>
          <p class="text-dark-muted-foreground text-sm" data-ps="src/components/home/ServiceSlider.astro:ffdch5">Es kann sinnvoll sein, ein älteres Schloss austauschen zu lassen für erhöhte Sicherheit.</p>
        </button>
        <button class="service-tab text-left p-6 bg-transparent border-l-4 border-transparent text-white/60 transition-all hover:bg-white/5" data-image="https://pagesmith-cdn.com/ceb8c319/images/austausch-von-schloss-e1619558456735-768.webp" data-ps="src/components/home/ServiceSlider.astro:lhkiuh">
          <h3 class="text-[24px] font-bold mb-2" data-ps="src/components/home/ServiceSlider.astro:oeboz7">Schließzylinder wechseln</h3>
          <p class="text-dark-muted-foreground text-sm" data-ps="src/components/home/ServiceSlider.astro:ffdch6">Lassen Sie frühzeitig den Schließzylinder austauschen, wenn das Schloss klemmt.</p>
        </button>
        <button class="service-tab text-left p-6 bg-transparent border-l-4 border-transparent text-white/60 transition-all hover:bg-white/5" data-image="https://pagesmith-cdn.com/ceb8c319/images/briefkasten-e1619558319460-768.webp" data-ps="src/components/home/ServiceSlider.astro:lhkiug">
          <h3 class="text-[24px] font-bold mb-2" data-ps="src/components/home/ServiceSlider.astro:oeboz8">Briefkastenschloss wechseln</h3>
          <p class="text-dark-muted-foreground text-sm">Wenn der Briefkastenschlüssel unauffindbar ist, genügt es meist, das Schloss zu wechseln.</p>
        </button>
      </div>
    </div>
  </Container>
</section>

<script is:inline>
  const tabs = document.querySelectorAll('.service-tab');
  const activeImage = document.getElementById('active-service-image');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      // Reset all tabs
      tabs.forEach(t => {
        t.classList.remove('bg-white/5', 'border-secondary', 'text-white');
        t.classList.add('bg-transparent', 'border-transparent', 'text-white/60');
      });
      
      // Activate clicked tab
      tab.classList.add('bg-white/5', 'border-secondary', 'text-white');
      tab.classList.remove('bg-transparent', 'border-transparent', 'text-white/60');
      
      // Update image
      if (activeImage) {
        activeImage.style.opacity = '0';
        setTimeout(() => {
          activeImage.src = tab.getAttribute('data-image');
          activeImage.style.opacity = '1';
        }, 200);
      }
    });
  });
</script>
