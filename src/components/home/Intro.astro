---
import Container from '@/components/Container.astro';
---

<section class="py-[48px] bg-surface" data-ps="src/components/home/Intro.astro:root">
  <Container>
    <h2 class="text-[44px] font-bold text-center text-foreground mb-12 font-heading" data-ps="src/components/home/Intro.astro:h2">
      Fairer Schlüsseldienst München gesucht?
    </h2>
    
    <div class="flex flex-col md:flex-row items-center gap-12" data-ps="src/components/home/Intro.astro:tqfr0a">
      <div class="shrink-0" data-ps="src/components/home/Intro.astro:image">
        <img src="https://pagesmith-cdn.com/ceb8c319/images/Monteur-rund-640.webp" alt="Monteur Schlüsseldienst München" class="w-[180px] h-[180px] rounded-full object-cover shadow-lg border-4 border-white" data-ps="src/components/home/Intro.astro:4t7mz" />
      </div>
      
      <div class="flex-1 text-muted-foreground text-[18px] leading-relaxed" data-ps="src/components/home/Intro.astro:text">
        <p class="mb-6" data-ps="src/components/home/Intro.astro:8uixh4">24 Stunden Notdienst in allen Stadtteilen</p>
        <p class="mb-6" data-ps="src/components/home/Intro.astro:8uixh5">Wir sind in allen <strong class="text-foreground">Stadtteilen Münchens</strong> tätig und helfen unseren Kunden seit Jahren schnell und zuverlässig wieder in ihre vier Wände.</p>
        <p class="mb-8" data-ps="src/components/home/Intro.astro:8uixh6">Rufen Sie einfach an und einer unserer Schlüsseldienste in München kommt <strong class="text-foreground">innerhalb von 10 – 40 Minuten</strong> zu Ihnen.</p>
        
        <a href="tel:+4915735981964" class="inline-flex items-center gap-2 bg-primary hover:bg-[#69b02e] text-white px-[16px] py-[10px] rounded-[9px] text-[18px] font-bold no-underline transition-colors" data-ps="src/components/home/Intro.astro:92s5hx">
          0157 359 819 64 Jetzt anrufen!
        </a>
      </div>
    </div>
  </Container>
</section>
