---
import Container from '@/components/Container.astro';
---

<section class="bg-dark-background py-[24px]" data-ps="src/components/home/TrustBar.astro:root">
  <Container class="flex flex-col md:flex-row justify-between items-center gap-8">
    <div class="flex items-center gap-4" data-ps="src/components/home/TrustBar.astro:rating">
      <img src="https://pagesmith-cdn.com/ceb8c319/images/bewertungssiegel-e1619561593946-128.webp" alt="Verifizierte Kundenbewertungen" class="w-[112px] h-[112px]" data-ps="src/components/home/TrustBar.astro:wh76z" />
      <div class="text-white" data-ps="src/components/home/TrustBar.astro:3eqbig">
        <div class="font-bold" data-ps="src/components/home/TrustBar.astro:3eqbih">Schlüsseldienst München</div>
        <div class="text-[20px] font-black" data-ps="src/components/home/TrustBar.astro:3eqbii">Ausgezeichnet</div>
        <div class="text-secondary" data-ps="src/components/home/TrustBar.astro:p3eiwy">★★★★★</div>
        <div class="text-sm" data-ps="src/components/home/TrustBar.astro:p3eiwx">4,8 von 5,0 aus 142 Bewertungen</div>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-white text-sm font-bold uppercase" data-ps="src/components/home/TrustBar.astro:features">
      <div class="flex items-center gap-2" data-ps="src/components/home/TrustBar.astro:p3eiww">
        <div class="w-6 h-6 rounded-full bg-primary flex items-center justify-center text-white" data-ps="src/components/home/TrustBar.astro:p3eiwv">✓</div>
        24 Std Notdienst
      </div>
      <div class="flex items-center gap-2" data-ps="src/components/home/TrustBar.astro:p3eiwu">
        <div class="w-6 h-6 rounded-full bg-primary flex items-center justify-center text-white" data-ps="src/components/home/TrustBar.astro:p3eiwt">✓</div>
        Türöffnung ohne Schäden
      </div>
      <div class="flex items-center gap-2" data-ps="src/components/home/TrustBar.astro:p3eiws">
        <div class="w-6 h-6 rounded-full bg-primary flex items-center justify-center text-white" data-ps="src/components/home/TrustBar.astro:p3eiwr">✓</div>
        Bar- & EC-Zahlung
      </div>
      <div class="flex items-center gap-2" data-ps="src/components/home/TrustBar.astro:p3eiwq">
        <div class="w-6 h-6 rounded-full bg-primary flex items-center justify-center text-white" data-ps="src/components/home/TrustBar.astro:p3eiwp">✓</div>
        In 10-40 Min vor Ort
      </div>
    </div>
  </Container>
</section>
