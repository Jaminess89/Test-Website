---
import Container from '@/components/Container.astro';
---

<section class="py-[120px] bg-background" data-ps="src/components/home/PriceList.astro:root">
  <Container>
    <h2 class="text-[44px] font-bold text-center text-foreground mb-16 font-heading" data-ps="src/components/home/PriceList.astro:h2">
      Schlüsseldienst München Preisliste
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10" data-ps="src/components/home/PriceList.astro:grid">
      <!-- Card 1 -->
      <div class="bg-surface rounded-xl shadow-sm border border-border overflow-hidden" data-ps="src/components/home/PriceList.astro:card-1">
        <div class="bg-secondary p-6 text-center" data-ps="src/components/home/PriceList.astro:cb1wm4">
          <h3 class="text-[24px] font-bold text-white m-0" data-ps="src/components/home/PriceList.astro:rr33ae">Türöffnung</h3>
        </div>
        <div class="p-8" data-ps="src/components/home/PriceList.astro:cb1wm5">
          <ul class="space-y-4 list-none p-0">
            <li class="flex justify-between items-center py-3 border-b border-border/50" data-ps="src/components/home/PriceList.astro:ndozwl">
              <span class="text-muted-foreground" data-ps="src/components/home/PriceList.astro:c78nel">09:00 – 18:00</span>
              <span class="font-bold text-foreground" data-ps="src/components/home/PriceList.astro:c78nek">29 – 159€</span>
            </li>
            <li class="flex justify-between items-center py-3 border-b border-border/50" data-ps="src/components/home/PriceList.astro:ndozwm">
              <span class="text-muted-foreground" data-ps="src/components/home/PriceList.astro:c78nej">An- und Abfahrtskosten</span>
              <span class="font-bold text-foreground" data-ps="src/components/home/PriceList.astro:c78nei">23,80€</span>
            </li>
            <li class="pt-4 font-bold text-foreground" data-ps="src/components/home/PriceList.astro:ndozwn">Notdienstzuschläge</li>
            <li class="flex justify-between items-center py-3 border-b border-border/50" data-ps="src/components/home/PriceList.astro:ndozwo">
              <span class="text-muted-foreground" data-ps="src/components/home/PriceList.astro:c78neh">Wochentags 18 – 22:00 Uhr</span>
              <span class="font-bold text-foreground" data-ps="src/components/home/PriceList.astro:c78neg">+ 50%</span>
            </li>
            <li class="flex justify-between items-center py-3" data-ps="src/components/home/PriceList.astro:ndozwp">
              <span class="text-muted-foreground" data-ps="src/components/home/PriceList.astro:c78nef">Sonn- und Feiertags</span>
              <span class="font-bold text-foreground" data-ps="src/components/home/PriceList.astro:c78nee">+ 100%</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="bg-surface rounded-xl shadow-sm border border-border overflow-hidden" data-ps="src/components/home/PriceList.astro:card-2">
        <div class="bg-secondary p-6 text-center" data-ps="src/components/home/PriceList.astro:cb1wm6">
          <h3 class="text-[24px] font-bold text-white m-0" data-ps="src/components/home/PriceList.astro:rr33af">Zusatzleistungen</h3>
        </div>
        <div class="p-8" data-ps="src/components/home/PriceList.astro:cb1wm7">
          <ul class="space-y-4 list-none p-0">
            <li class="flex justify-between items-center py-3 border-b border-border/50" data-ps="src/components/home/PriceList.astro:ndozwq">
              <span class="text-muted-foreground" data-ps="src/components/home/PriceList.astro:dcr7r2">Angefangene 15 Minuten</span>
              <span class="font-bold text-foreground" data-ps="src/components/home/PriceList.astro:dcr7r3">19,90€</span>
            </li>
            <li class="flex justify-between items-center py-3 border-b border-border/50" data-ps="src/components/home/PriceList.astro:ndozwr">
              <span class="text-muted-foreground" data-ps="src/components/home/PriceList.astro:dcr7r4">Sicherheitszylinder</span>
              <span class="font-bold text-foreground" data-ps="src/components/home/PriceList.astro:dcr7r5">ab 49€</span>
            </li>
            <li class="flex justify-between items-center py-3 border-b border-border/50" data-ps="src/components/home/PriceList.astro:ndozxd">
              <span class="text-muted-foreground" data-ps="src/components/home/PriceList.astro:dcr7r6">Sicherheitsbeschlag</span>
              <span class="font-bold text-foreground" data-ps="src/components/home/PriceList.astro:dcr7r7">ab 79€</span>
            </li>
            <li class="flex justify-between items-center py-3" data-ps="src/components/home/PriceList.astro:ndozxe">
              <span class="text-muted-foreground" data-ps="src/components/home/PriceList.astro:dcr7r8">Sonstiges</span>
              <span class="font-bold text-foreground" data-ps="src/components/home/PriceList.astro:dcr7r9">auf Anfrage</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </Container>
</section>
