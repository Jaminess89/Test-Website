---
import { protocolRows } from "../data/site";
import Container from "./ui/Container.astro";
import SectionHeading from "./ui/SectionHeading.astro";
import Icon from "./ui/Icon.astro";

const sidebarItems = ["Übersicht", "Objekte", "Prüfprotokolle", "Dokumente"];
const metaItems = [
  { label: "Wohnung", value: "3 OG links" },
  { label: "Prüfdatum", value: "14.07.2026" },
  { label: "Gerätestandorte", value: "5" },
  { label: "Offene Maßnahmen", value: "1" },
];
---

<section class="section" id="pruefprotokoll" data-ps="src/components/ProtocolPreview.astro:8y6kya">
  <Container>
    <SectionHeading
      overline="Digital dokumentiert"
      title="Alles je Wohnung im Blick"
      lead="Prüfung, Zustand und Maßnahmen übersichtlich zusammengefasst."
    />

    <div class="dashboard" data-ps="src/components/ProtocolPreview.astro:upakl">
      <aside class="dashboard__side" aria-label="Beispiel-Navigation" data-ps="src/components/ProtocolPreview.astro:jyodhx">
        <span class="dashboard__brand" data-ps="src/components/ProtocolPreview.astro:wj57ep">Rauchmelder Express</span>
        <ul role="list">
          {
            sidebarItems.map((item, index) => (
              <li
                class:list={[
                  "dashboard__side-item",
                  { "dashboard__side-item--active": index === 2 },
                ]}
               data-ps={`src/components/ProtocolPreview.astro:4jfrs2-${index}`}>
                {item}
              </li>
            ))
          }
        </ul>
      </aside>

      <div class="dashboard__main" data-ps="src/components/ProtocolPreview.astro:upakk">
        <div class="dashboard__head" data-ps="src/components/ProtocolPreview.astro:upakj">
          <h3 data-ps="src/components/ProtocolPreview.astro:jytli2">Prüfprotokoll – Musterstraße 12</h3>
          <span class="dashboard__badge" data-ps="src/components/ProtocolPreview.astro:wj57eq">Beispiel</span>
        </div>

        <dl class="dashboard__meta">
          {
            metaItems.map((meta, __psIdx) => (
              <div class="dashboard__meta-item" data-ps={`src/components/ProtocolPreview.astro:upaki-${__psIdx}`}>
                <dt>{meta.label}</dt>
                <dd>{meta.value}</dd>
              </div>
            ))
          }
        </dl>

        <div class="dashboard__table-wrap" tabindex="0" role="region" aria-label="Beispiel-Prüftabelle, horizontal scrollbar" data-ps="src/components/ProtocolPreview.astro:upakh">
          <table class="dashboard__table">
            <thead>
              <tr>
                <th scope="col">Raum</th>
                <th scope="col">Zustand</th>
                <th scope="col">Maßnahme</th>
                <th scope="col">Nächster Termin</th>
              </tr>
            </thead>
            <tbody>
              {
                protocolRows.map((row, __psIdx) => (
                  <tr>
                    <th scope="row">{row.room}</th>
                    <td>
                      <span class:list={["status", `status--${row.status}`]} data-ps={`src/components/ProtocolPreview.astro:wj57er-${__psIdx}`}>
                        {row.statusLabel}
                      </span>
                    </td>
                    <td>{row.action}</td>
                    <td>{row.next}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <div class="dashboard__actions" data-ps="src/components/ProtocolPreview.astro:upakg">
          <button type="button" class="pdf-btn" data-dialog-open="protocol-dialog" data-ps="src/components/ProtocolPreview.astro:7pbvun">
            <Icon name="download" size={17} />
            Beispielprotokoll ansehen
          </button>
        </div>
      </div>
    </div>

    <dialog class="dialog" id="protocol-dialog" aria-labelledby="protocol-dialog-title">
      <div class="dialog__head" data-ps="src/components/ProtocolPreview.astro:upakf">
        <h3 id="protocol-dialog-title" data-ps="src/components/ProtocolPreview.astro:jytli1">Vorschau: Muster-Prüfprotokoll</h3>
        <div class="dialog__controls" data-ps="src/components/ProtocolPreview.astro:upake">
          <a href="https://pagesmith-cdn.com/ceb8c319/files/rauchmelder-express-muster-pruefprotokoll.pdf" download class="dialog__download" data-ps="src/components/ProtocolPreview.astro:download-pdf">
            <Icon name="download" size={18} />
            <span data-ps="src/components/ProtocolPreview.astro:a7q8mh">PDF laden</span>
          </a>
          <button type="button" class="dialog__close" data-dialog-close aria-label="Dialog schließen" data-ps="src/components/ProtocolPreview.astro:7pbvuo">
            <Icon name="close" size={20} />
          </button>
        </div>
      </div>
      
      <div class="dialog__content" data-ps="src/components/ProtocolPreview.astro:pdf-container">
        <iframe 
          src="https://pagesmith-cdn.com/ceb8c319/files/rauchmelder-express-muster-pruefprotokoll.pdf#toolbar=0" 
          class="dialog__pdf"
          title="Muster-Prüfprotokoll PDF"
          loading="lazy"
        ></iframe>
      </div>
    </dialog>
  </Container>
</section>

<script>
  const dialog = document.getElementById("protocol-dialog") as HTMLDialogElement | null;
  const openButton = document.querySelector<HTMLButtonElement>('[data-dialog-open="protocol-dialog"]');

  if (dialog && openButton) {
    openButton.addEventListener("click", () => {
      dialog.showModal();
    });

    dialog.querySelector("[data-dialog-close]")?.addEventListener("click", () => {
      dialog.close();
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .section {
    padding-block: var(--section-space);
    background: var(--color-surface-blue);
    border-block: 1px solid var(--color-border);
  }

  .dashboard {
    display: grid;
    max-width: 60rem;
    margin-inline: auto;
    background: var(--color-white);
    border: 1px solid var(--color-border-premium);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .dashboard__side {
    display: none;
    padding: 1.5rem 1.25rem;
    background: var(--color-navy-950);
    color: var(--color-white);
  }

  .dashboard__brand {
    display: block;
    font-weight: 800;
    font-size: 0.9rem;
    letter-spacing: -0.01em;
    margin-block-end: 1.5rem;
    padding-block-end: 1rem;
    border-block-end: 1px solid rgb(255 255 255 / 0.12);
  }

  .dashboard__side ul {
    display: grid;
    gap: 0.35rem;
    padding: 0;
    list-style: none;
  }

  .dashboard__side-item {
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius);
    font-size: 0.88rem;
    color: rgb(255 255 255 / 0.75);
  }

  .dashboard__side-item--active {
    background: rgb(255 255 255 / 0.1);
    color: var(--color-white);
    border-inline-start: 3px solid var(--color-gold-500);
  }

  .dashboard__main {
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .dashboard__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 1.25rem;
  }

  .dashboard__badge {
    flex-shrink: 0;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    background: var(--color-gold-100);
    color: var(--color-gold-600);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .dashboard__meta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    margin-block-end: 1.5rem;
  }

  .dashboard__meta-item {
    padding: 0.75rem 1rem;
    background: var(--color-blue-50);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .dashboard__meta-item dt {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .dashboard__meta-item dd {
    margin: 0.15rem 0 0;
    font-weight: 700;
    color: var(--color-navy-900);
  }

  .dashboard__table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }

  .dashboard__table {
    width: 100%;
    min-width: 34rem;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .dashboard__table th,
  .dashboard__table td {
    padding: 0.75rem 1rem;
    text-align: start;
    border-block-end: 1px solid var(--color-border);
  }

  .dashboard__table thead th {
    background: var(--color-navy-900);
    color: var(--color-white);
    font-size: 0.78rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .dashboard__table tbody th {
    font-weight: 600;
    color: var(--color-navy-900);
  }

  .dashboard__table tbody tr:last-child th,
  .dashboard__table tbody tr:last-child td {
    border-block-end: 0;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .status::before {
    content: "";
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
  }

  .status--ok {
    color: var(--color-emerald-700);
  }

  .status--ok::before {
    background: var(--color-emerald-500);
  }

  .status--warning {
    color: var(--color-warning);
  }

  .status--warning::before {
    background: #f59e0b;
  }

  .dashboard__actions {
    display: flex;
    justify-content: flex-end;
    margin-block-start: 1.25rem;
  }

  .pdf-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.6rem 1.2rem;
    background: var(--color-white);
    border: 1px solid var(--color-navy-800);
    border-radius: var(--radius);
    color: var(--color-navy-900);
    font-weight: 600;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .pdf-btn:hover {
    background: var(--color-navy-900);
    color: var(--color-white);
  }

  .dialog {
    width: min(64rem, calc(100vw - 2rem));
    max-height: 90vh;
    padding: 0;
    border: 1px solid var(--color-border-premium);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .dialog::backdrop {
    background: rgb(7 24 45 / 0.6);
    backdrop-filter: blur(4px);
  }

  .dialog__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--color-white);
    border-block-end: 1px solid var(--color-border);
  }

  .dialog__controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .dialog__download {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-emerald-700);
    text-decoration: none;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius);
    background: var(--color-emerald-50);
  }

  .dialog__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-white);
    color: var(--color-navy-900);
    transition: all 0.2s ease;
  }

  .dialog__close:hover {
    background: var(--color-surface-soft);
    transform: scale(1.05);
  }

  .dialog__content {
    height: 75vh;
    background: var(--color-surface-soft);
  }

  .dialog__pdf {
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (min-width: 800px) {
    .dashboard {
      grid-template-columns: 13rem 1fr;
    }

    .dashboard__side {
      display: block;
    }

    .dashboard__meta {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
