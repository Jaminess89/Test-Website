---
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';
---

<footer class="bg-dark-background text-dark-muted-foreground py-16" data-ps="src/components/Footer.astro:ikmf33">
  <Container>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12" data-ps="src/components/Footer.astro:grid">
      <!-- Brand Info -->
      <div data-ps="src/components/Footer.astro:col1">
        <h2 class="text-[24px] font-normal text-white mb-6" data-ps="src/components/Footer.astro:title">
          <span class="font-bold" data-ps="src/components/Footer.astro:hzwfpe">Schlüsseldienst</span> München
        </h2>
        <p class="text-sm leading-relaxed mb-6" data-ps="src/components/Footer.astro:euop">
          Schlüsseldienst-München.bayern<br/>
          Woferlstraße 5, München 81737<br/>
          Kundenservice: +4915735981964
        </p>
        <p class="text-xs opacity-60" data-ps="src/components/Footer.astro:euoq">
          © {new Date().getFullYear()} {SITE.name}. Alle Rechte vorbehalten.
        </p>
      </div>

      <!-- Quick Links -->
      <div data-ps="src/components/Footer.astro:col2">
        <h3 class="text-white font-bold mb-6" data-ps="src/components/Footer.astro:fh1w67">Quick Links</h3>
        <ul class="list-none p-0 flex flex-col gap-3">
          <li data-ps="src/components/Footer.astro:wyji6k"><a href="/leistungen/" class="hover:text-white transition-colors" data-ps="src/components/Footer.astro:7gqc0e">Leistungen</a></li>
          <li data-ps="src/components/Footer.astro:wyji6l"><a href="/einbruchschutz/" class="hover:text-white transition-colors" data-ps="src/components/Footer.astro:7gqc0f">Einbruchschutz München</a></li>
          <li data-ps="src/components/Footer.astro:wyji6m"><a href="/preise/" class="hover:text-white transition-colors" data-ps="src/components/Footer.astro:7gqc0g">Preise</a></li>
          <li data-ps="src/components/Footer.astro:wyji6n"><a href="/datenschutzerklaerung/" class="hover:text-white transition-colors" data-ps="src/components/Footer.astro:7gqc0h">Datenschutzerklärung</a></li>
          <li data-ps="src/components/Footer.astro:wyji79"><a href="/impressum/" class="hover:text-white transition-colors" data-ps="src/components/Footer.astro:7gqc0i">Impressum</a></li>
        </ul>
      </div>

      <!-- Locations -->
      <div data-ps="src/components/Footer.astro:col3">
        <h3 class="text-white font-bold mb-6" data-ps="src/components/Footer.astro:fh1w66">Stadtteile</h3>
        <div class="grid grid-cols-2 gap-2 text-xs" data-ps="src/components/Footer.astro:p4vf8b">
          <a href="/bogenhausen/" class="hover:text-white transition-colors" data-ps="src/components/Footer.astro:7gqc0j">Bogenhausen</a>
          <a href="/giesing/" class="hover:text-white transition-colors" data-ps="src/components/Footer.astro:7gqc0k">Giesing</a>
          <a href="/haidhausen/" class="hover:text-white transition-colors" data-ps="src/components/Footer.astro:7gqc0l">Haidhausen</a>
          <a href="/maxvorstadt/" class="hover:text-white transition-colors" data-ps="src/components/Footer.astro:7gqc0m">Maxvorstadt</a>
          <a href="/neuhausen/" class="hover:text-white transition-colors" data-ps="src/components/Footer.astro:8o2pe">Neuhausen</a>
          <a href="/pasing/" class="hover:text-white transition-colors" data-ps="src/components/Footer.astro:8o2pf">Pasing</a>
          <a href="/schwabing/" class="hover:text-white transition-colors" data-ps="src/components/Footer.astro:8o2pg">Schwabing</a>
          <a href="/sendling/" class="hover:text-white transition-colors" data-ps="src/components/Footer.astro:8o2ph">Sendling</a>
        </div>
      </div>
    </div>
  </Container>
</footer>
