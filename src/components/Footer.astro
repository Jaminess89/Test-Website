---
import { brand, contact } from "../data/site";
import Container from "./ui/Container.astro";
import Logo from "./ui/Logo.astro";
import Icon from "./ui/Icon.astro";
import LegalDetails from "./LegalDetails.astro";

const currentYear = new Date().getFullYear();

const footerLinks = [
  { label: "Leistungen", href: "#leistungen" },
  { label: "Ablauf", href: "#ablauf" },
  { label: "Prüfprotokoll", href: "#pruefprotokoll" },
  { label: "Bezirke", href: "#bezirke" },
  { label: "FAQ", href: "#faq" },
  { label: "Angebot", href: "#angebot" },
  { label: "Impressum", href: "#impressum" },
  { label: "Datenschutz", href: "#datenschutz" },
];
---

<footer class="footer">
  <Container>
    <div class="footer__grid">
      <div class="footer__brand">
        <Logo light />
        <p class="footer__tagline">{brand.tagline}</p>
      </div>

      <div class="footer__contact">
        <h2 class="footer__heading">Kontakt</h2>
        <address>
          {contact.company}<br />
          {contact.street}<br />
          {contact.city}
        </address>
        <a href={contact.phoneHref} class="footer__contact-link">
          <Icon name="phone" size={16} />
          {contact.phoneDisplay}
        </a>
        <a href={`mailto:${contact.email}`} class="footer__contact-link">
          <Icon name="mail" size={16} />
          {contact.email}
        </a>
        <p class="footer__region">
          <Icon name="map-pin" size={16} />
          {contact.region}
        </p>
      </div>

      <nav class="footer__nav" aria-label="Fußzeilen-Navigation">
        <h2 class="footer__heading">Navigation</h2>
        <ul role="list">
          {
            footerLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="footer__legal">
      <LegalDetails />
    </div>

    <div class="footer__bar">
      <p>© {currentYear} {brand.name}. Alle Rechte vorbehalten.</p>
    </div>
  </Container>
</footer>

<style>
  .footer {
    background: var(--color-navy-950);
    color: rgb(255 255 255 / 0.8);
    padding-block: clamp(2.5rem, 5vw, 4rem) 1.5rem;
  }

  .footer__grid {
    display: grid;
    gap: 2.25rem;
    padding-block-end: 2.25rem;
  }

  .footer__tagline {
    margin-block-start: 0.9rem;
    font-size: 0.92rem;
    color: rgb(255 255 255 / 0.65);
  }

  .footer__heading {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold-500);
    margin-block-end: 1rem;
  }

  .footer__contact address {
    font-style: normal;
    line-height: 1.7;
    margin-block-end: 1rem;
  }

  .footer__contact-link,
  .footer__region {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 32px;
    color: rgb(255 255 255 / 0.85);
    text-decoration: none;
    margin-block-end: 0.35rem;
  }

  .footer__contact-link:hover {
    color: var(--color-gold-500);
  }

  .footer__nav ul {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.35rem 1.5rem;
    padding: 0;
    list-style: none;
  }

  .footer__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: rgb(255 255 255 / 0.8);
    text-decoration: none;
  }

  .footer__nav a:hover {
    color: var(--color-gold-500);
  }

  .footer__legal {
    padding-block: 1.5rem;
    border-block-start: 1px solid rgb(255 255 255 / 0.12);
  }

  .footer__bar {
    padding-block-start: 1.25rem;
    border-block-start: 1px solid rgb(255 255 255 / 0.12);
    font-size: 0.85rem;
    color: rgb(255 255 255 / 0.55);
    text-align: center;
  }

  @media (min-width: 800px) {
    .footer__grid {
      grid-template-columns: 1.2fr 1fr 1fr;
      gap: 3rem;
    }
  }
</style>
