---
import Container from '@/components/Container.astro';

const year = new Date().getFullYear();
---

<footer class="relative bg-[#02182b] text-white pt-14 pb-8 overflow-hidden border-t border-white/10">
  <!-- Subtle top highlight -->
  <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-white/20 to-transparent" aria-hidden="true"></div>

  <Container class="relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 xl:gap-12 pb-12 items-start">

      <!-- Left Column: Brand -->
      <div class="lg:col-span-4 flex flex-col gap-6">
        <div class="flex items-center gap-3">
          <span class="flex items-center justify-center w-11 h-11 rounded-xl bg-gradient-to-br from-[#1d4e79] to-[#0a2c49] border border-white/20 shrink-0" aria-hidden="true">
            <svg viewBox="0 0 48 48" class="w-6 h-6">
              <defs>
                <linearGradient id="footer-bolt" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#8ef05a" />
                  <stop offset="100%" stop-color="#2fae3f" />
                </linearGradient>
              </defs>
              <path d="M26.5 6 13 27h8.5L18 42 35 19h-8.5Z" fill="url(#footer-bolt)" />
            </svg>
          </span>
          <div class="flex flex-col leading-tight">
            <span class="font-heading text-[17px] font-black text-white tracking-tight">DGUV V3 Prüfung Berlin</span>
            <span class="text-[10px] font-bold tracking-[0.16em] uppercase text-[#63c62f] mt-1">E-Check nach VDE · BGV A3</span>
          </div>
        </div>
        <p class="text-[13px] text-white/60 leading-relaxed max-w-xs m-0">
          Zertifizierter Fachbetrieb für die DGUV V3 Prüfung in Berlin. Wir prüfen Ihre Geräte &amp; Anlagen nach DGUV Vorschrift 3. Sicher, zuverlässig und gesetzeskonform.
        </p>
      </div>

      <!-- Center Columns: Sektionen & Unternehmen -->
      <div class="lg:col-span-5 grid grid-cols-2 gap-8">

        <!-- Spalte: Sektionen -->
        <div>
          <h4 class="text-[13px] font-extrabold uppercase tracking-wider text-white mb-4">Sektionen</h4>
          <ul class="flex flex-col gap-2.5">
            <li>
              <a href="/#pflicht" class="text-[13px] text-white/70 hover:text-white transition-colors flex items-center justify-between group">
                <span>Prüfung: Pflicht?</span>
                <span class="text-white/30 group-hover:text-[#63c62f] transition-colors text-[12px]">›</span>
              </a>
            </li>
            <li>
              <a href="/#risiken" class="text-[13px] text-white/70 hover:text-white transition-colors flex items-center justify-between group">
                <span>Risiken + Vorteile</span>
                <span class="text-white/30 group-hover:text-[#63c62f] transition-colors text-[12px]">›</span>
              </a>
            </li>
            <li>
              <a href="/#dguv-v3" class="text-[13px] text-white/70 hover:text-white transition-colors flex items-center justify-between group">
                <span>Was ist DGUV V3?</span>
                <span class="text-white/30 group-hover:text-[#63c62f] transition-colors text-[12px]">›</span>
              </a>
            </li>
            <li>
              <a href="/#pruefumfang" class="text-[13px] text-white/70 hover:text-white transition-colors flex items-center justify-between group">
                <span>Was ist zu prüfen?</span>
                <span class="text-white/30 group-hover:text-[#63c62f] transition-colors text-[12px]">›</span>
              </a>
            </li>
            <li>
              <a href="/#prueffristen" class="text-[13px] text-white/70 hover:text-white transition-colors flex items-center justify-between group">
                <span>Wie oft prüfen?</span>
                <span class="text-white/30 group-hover:text-[#63c62f] transition-colors text-[12px]">›</span>
              </a>
            </li>
          </ul>
        </div>


        <!-- Spalte: Unternehmen -->
        <div>
          <h4 class="text-[13px] font-extrabold uppercase tracking-wider text-white mb-4">Unternehmen</h4>
          <ul class="flex flex-col gap-2.5">
            <li>
              <a href="/#warum-wir" class="text-[13px] text-white/70 hover:text-white transition-colors flex items-center justify-between group">
                <span>Warum wir</span>
                <span class="text-white/30 group-hover:text-[#63c62f] transition-colors text-[12px]">›</span>
              </a>
            </li>
            <li>
              <a href="/#pruefablauf" class="text-[13px] text-white/70 hover:text-white transition-colors flex items-center justify-between group">
                <span>Prüfablauf</span>
                <span class="text-white/30 group-hover:text-[#63c62f] transition-colors text-[12px]">›</span>
              </a>
            </li>
            <li>
              <a href="/#ablauf" class="text-[13px] text-white/70 hover:text-white transition-colors flex items-center justify-between group">
                <span>Ablauf</span>
                <span class="text-white/30 group-hover:text-[#63c62f] transition-colors text-[12px]">›</span>
              </a>
            </li>
            <li>
              <a href="/#bewertungen" class="text-[13px] text-white/70 hover:text-white transition-colors flex items-center justify-between group">
                <span>Bewertungen</span>
                <span class="text-white/30 group-hover:text-[#63c62f] transition-colors text-[12px]">›</span>
              </a>
            </li>
            <li>
              <a href="/#angebot" class="text-[13px] text-white/70 hover:text-white transition-colors flex items-center justify-between group">
                <span>Angebot anfordern</span>
                <span class="text-white/30 group-hover:text-[#63c62f] transition-colors text-[12px]">›</span>
              </a>
            </li>
          </ul>
        </div>
      </div>

      <!-- Right Column: Kontakt -->
      <div class="lg:col-span-3">
        <h4 class="text-[13px] font-extrabold uppercase tracking-wider text-white mb-4">Kontakt</h4>
        <div class="flex flex-col gap-4">

          <!-- Phone Item -->
          <a href="tel:+493020007607" class="flex items-center gap-3.5 group no-underline text-white">
            <div class="w-10 h-10 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center shrink-0 group-hover:bg-[#63c62f] group-hover:border-[#63c62f] transition-colors">
              <svg class="w-4 h-4 text-white" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 7 8 11c-2 2 1 11 8 19s16 12 19 10l5-6-10-7-5 5c-5-3-9-7-11-12l5-4z"/>
              </svg>
            </div>
            <div>
              <div class="text-[14px] font-bold group-hover:text-[#63c62f] transition-colors leading-tight">030 20007607</div>
              <div class="text-[11px] text-white/60 mt-0.5">Unverbindliches Angebot anfordern</div>
            </div>
          </a>

          <!-- Mail Item -->
          <a href="mailto:info@elektro-prüfdienst.de" class="flex items-center gap-3.5 group no-underline text-white">
            <div class="w-10 h-10 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center shrink-0 group-hover:bg-[#63c62f] group-hover:border-[#63c62f] transition-colors">
              <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <div class="text-[14px] font-bold group-hover:text-[#63c62f] transition-colors leading-tight break-all">info@elektro-prüfdienst.de</div>
              <div class="text-[11px] text-white/60 mt-0.5">Wir antworten i. d. R. innerhalb 24h.</div>
            </div>
          </a>

          <!-- Location Item -->
          <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center shrink-0">
              <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <div class="text-[14px] font-bold text-white leading-tight">Berlin und Umgebung</div>
              <div class="text-[11px] text-white/60 mt-0.5">Vor Ort für Sie da.</div>
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- Bottom Bar / Legal Links, Disclaimer & Copyright -->
    <div class="border-t border-white/10 pt-6 flex flex-col md:flex-row items-center justify-between gap-4 text-white/60 text-[12px]">
      <div class="flex items-center gap-4">
        <span>Copyright © {year} Elektroprüfung. All Rights Reserved.</span>
      </div>

      <!-- Center Legal Links -->
      <div class="flex items-center gap-6 text-[12px]">
        <a href="/impressum/" class="text-white/70 hover:text-white transition-colors">Impressum</a>
        <span class="w-[1px] h-3 bg-white/20" aria-hidden="true"></span>
        <a href="/datenschutzerklaerung/" class="text-white/70 hover:text-white transition-colors">Datenschutzerklärung</a>
      </div>

      <!-- Right Disclaimer Text -->
      <div class="text-[11px] text-white/50 text-center md:text-right max-w-sm">
        Rechtliche Angaben dienen der allgemeinen Information und ersetzen keine Rechtsberatung.
      </div>
    </div>
  </Container>
</footer>