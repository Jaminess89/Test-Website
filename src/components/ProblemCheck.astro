---
import { problemChecks } from "../data/site";
import Container from "./ui/Container.astro";
import SectionHeading from "./ui/SectionHeading.astro";
import Button from "./ui/Button.astro";
import Icon from "./ui/Icon.astro";
---

<section class="section" id="nachweis-check">
  <Container>
    <SectionHeading
      title="Ist Ihr Nachweis vollständig?"
      lead="Vier Fragen zeigen, ob noch etwas fehlt."
    />
    <div class="panel">
      <ul class="list" role="list">
        {
          problemChecks.map((check, index) => (
            <li class="item">
              <span class="item__number">{String(index + 1).padStart(2, "0")}</span>
              <span class="item__question">{check.question}</span>
              <span class="item__icon">
                <Icon name="question" size={20} />
              </span>
            </li>
          ))
        }
      </ul>
      <div class="panel__cta">
        <Button href="#angebot" arrow>Nachweis kostenlos prüfen lassen</Button>
      </div>
    </div>
  </Container>
</section>

<style>
  .section {
    padding-block: var(--section-space);
    background: var(--color-surface-blue);
    border-block: 1px solid var(--color-border);
  }

  .panel {
    max-width: 46rem;
    margin-inline: auto;
    background: var(--color-white);
    border: 1px solid var(--color-border-premium);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .list {
    padding: 0;
    list-style: none;
  }

  .item {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 1.15rem 1.5rem;
  }

  .item + .item {
    border-block-start: 1px solid var(--color-border);
  }

  .item__number {
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-gold-600);
  }

  .item__question {
    flex: 1;
    font-weight: 600;
    color: var(--color-navy-900);
  }

  .item__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: var(--color-blue-50);
    color: var(--color-blue-700);
  }

  .panel__cta {
    display: flex;
    justify-content: center;
    padding: 1.4rem 1.5rem;
    background: var(--color-ivory);
    border-block-start: 1px solid var(--color-border);
  }
</style>
