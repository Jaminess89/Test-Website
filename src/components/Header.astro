---
import { navItems } from "../data/site";
import Logo from "./ui/Logo.astro";
import Icon from "./ui/Icon.astro";
---

<header class="header" data-header>
  <div class="header__inner">
    <Logo />
    <nav class="header__nav" aria-label="Hauptnavigation">
      <ul class="header__list" role="list">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={["header__link", { "header__link--cta": item.cta }]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button
      type="button"
      class="header__toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Menü öffnen"
      data-menu-toggle
    >
      <span class="header__toggle-open"><Icon name="menu" size={26} /></span>
      <span class="header__toggle-close"><Icon name="close" size={26} /></span>
    </button>
  </div>
  <div class="header__mobile" id="mobile-menu" hidden data-mobile-menu>
    <nav aria-label="Mobile Navigation">
      <ul class="header__mobile-list" role="list">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={["header__mobile-link", { "header__mobile-link--cta": item.cta }]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = header?.querySelector<HTMLElement>("[data-mobile-menu]");

  if (header && toggle && menu) {
    const openIcon = toggle.querySelector<HTMLElement>(".header__toggle-open");
    const closeIcon = toggle.querySelector<HTMLElement>(".header__toggle-close");

    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Menü schließen" : "Menü öffnen");
      menu.hidden = !open;
      document.body.style.overflow = open ? "hidden" : "";
      if (openIcon) openIcon.style.display = open ? "none" : "";
      if (closeIcon) closeIcon.style.display = open ? "" : "none";
      header.classList.toggle("header--open", open);
    };

    setOpen(false);

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      if (
        toggle.getAttribute("aria-expanded") === "true" &&
        !header.contains(event.target as Node)
      ) {
        setOpen(false);
      }
    });

    // Kompakter Header nach dem Scrollen
    const onScroll = () => {
      header.classList.toggle("header--scrolled", window.scrollY > 12);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>

<style>
  .header {
    position: sticky;
    inset-block-start: 0;
    z-index: 100;
    background: rgb(255 255 255 / 0.96);
    backdrop-filter: blur(8px);
    border-block-end: 1px solid var(--color-border);
    transition: box-shadow 0.2s ease;
  }

  .header--scrolled {
    box-shadow: var(--shadow-sm);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: calc(var(--container-max) + 2 * var(--gutter));
    margin-inline: auto;
    padding: 0.7rem var(--gutter);
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0;
    list-style: none;
  }

  .header__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius);
    color: var(--color-navy-900);
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .header__link:hover {
    color: var(--color-emerald-700);
    background: var(--color-emerald-50);
  }

  .header__link--cta {
    margin-inline-start: 0.5rem;
    background: var(--color-emerald-600);
    color: var(--color-white);
    box-shadow: 0 2px 8px rgb(22 122 66 / 0.25);
  }

  .header__link--cta:hover {
    background: var(--color-emerald-700);
    color: var(--color-white);
  }

  .header__toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-white);
    color: var(--color-navy-900);
  }

  .header__toggle-close {
    display: none;
  }

  .header__mobile {
    border-block-start: 1px solid var(--color-border);
    background: var(--color-white);
  }

  .header__mobile-list {
    display: grid;
    gap: 0.25rem;
    padding: 0.75rem var(--gutter) 1.25rem;
    list-style: none;
  }

  .header__mobile-link {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0.6rem 1rem;
    border-radius: var(--radius);
    color: var(--color-navy-900);
    font-weight: 600;
    text-decoration: none;
  }

  .header__mobile-link:hover {
    background: var(--color-blue-50);
  }

  .header__mobile-link--cta {
    background: var(--color-emerald-600);
    color: var(--color-white);
    justify-content: center;
    margin-block-start: 0.5rem;
  }

  .header__mobile-link--cta:hover {
    background: var(--color-emerald-700);
  }

  @media (max-width: 900px) {
    .header__nav {
      display: none;
    }

    .header__toggle {
      display: inline-flex;
    }
  }

  @media (min-width: 901px) {
    .header__mobile {
      display: none;
    }
  }
</style>
