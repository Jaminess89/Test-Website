---
import { navItems } from "../data/site";
import Logo from "./ui/Logo.astro";
import Icon from "./ui/Icon.astro";
---

<header class="header" data-header data-ps="src/components/Header.astro:1hylap">
  <div class="header__inner" data-ps="src/components/Header.astro:mh9y3s">
    <Logo />
    <nav class="header__nav" aria-label="Hauptnavigation" data-ps="src/components/Header.astro:gevbcv">
      <ul class="header__list" role="list">
        {
          navItems.filter(item => !item.cta).map((item, __psIdx) => (
            <li data-ps={`src/components/Header.astro:3scb8h-${__psIdx}`}>
              <a href={item.href} class="header__link" data-ps={`src/components/Header.astro:ui7vpb-${__psIdx}`}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    
    <div class="header__actions" data-ps="src/components/Header.astro:actions">
      {navItems.find(item => item.cta) && (
        <a href={navItems.find(item => item.cta)?.href} class="header__link header__link--cta" data-ps="src/components/Header.astro:cta-anfrage">
          ANFRAGE
        </a>
      )}
      <a href="tel:015735981964" class="header__link header__link--phone md:text-[15.6px]" data-ps="src/components/Header.astro:cta-phone">
        0157 359 819 64
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");

  if (header) {
    // Kompakter Header nach dem Scrollen
    const onScroll = () => {
      header.classList.toggle("header--scrolled", window.scrollY > 12);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>

<style>
  .header {
    position: sticky;
    inset-block-start: 0;
    z-index: 100;
    background: rgb(255 255 255 / 0.96);
    backdrop-filter: blur(8px);
    border-block-end: 1px solid var(--color-border);
    transition: box-shadow 0.2s ease;
  }

  .header--scrolled {
    box-shadow: var(--shadow-sm);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    max-width: calc(var(--container-max) + 2 * var(--gutter));
    margin-inline: auto;
    padding: 0.7rem var(--gutter);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .header__inner::-webkit-scrollbar {
    display: none;
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0;
    list-style: none;
    white-space: nowrap;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .header__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius);
    color: var(--color-navy-900);
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .header__link:hover {
    color: var(--color-emerald-700);
    background: var(--color-emerald-50);
  }

  .header__link--cta {
    background: var(--color-emerald-500);
    color: var(--color-white);
    box-shadow: 0 2px 8px rgb(40 173 94 / 0.25);
    text-transform: uppercase;
    font-weight: 700;
  }

  .header__link--cta:hover {
    background: var(--color-emerald-600);
    color: var(--color-white);
  }

  .header__link--phone {
    background: var(--color-blue-700);
    color: var(--color-white);
    box-shadow: 0 2px 8px rgb(24 91 145 / 0.25);
    font-weight: 700;
    font-size: 1.1rem;
  }

  .header__link--phone:hover {
    background: var(--color-navy-800);
    color: var(--color-white);
  }

  @media (max-width: 1024px) {
    .header__actions {
      display: none;
    }
    
    .header__inner {
      padding: 0.5rem 1rem;
    }

    .header__link {
      padding: 0.4rem 0.5rem;
      font-size: 0.85rem;
    }
    
    /* Logo auf Mobile etwas verkleinern */
    .header__inner > :first-child {
      transform: scale(0.85);
      transform-origin: left center;
      margin-right: auto;
    }
  }
  
  @media (max-width: 500px) {
    .header__inner {
      padding: 0.5rem;
      gap: 0.25rem;
    }
    .header__link {
      padding: 0.4rem;
      font-size: 0.8rem;
    }
    .header__inner > :first-child {
      transform: scale(0.75);
    }
  }
</style>
