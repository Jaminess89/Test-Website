---
import { trustPoints } from "../data/site";
import Container from "./ui/Container.astro";
import Icon from "./ui/Icon.astro";
---

<section class="trustbar" aria-label="Ihre Vorteile auf einen Blick">
  <Container>
    <ul class="trustbar__list" role="list">
      {
        trustPoints.map((point) => (
          <li class="trustbar__item">
            <span class="trustbar__icon">
              <Icon name={point.icon} size={22} />
            </span>
            <span class="trustbar__label">{point.label}</span>
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<style>
  .trustbar {
    background: var(--color-navy-900);
    color: var(--color-white);
  }

  .trustbar__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem 2rem;
    padding: 1.4rem 0;
    list-style: none;
  }

  .trustbar__item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .trustbar__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(184 154 91 / 0.45);
    color: var(--color-gold-500);
  }

  .trustbar__label {
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
  }

  @media (min-width: 768px) {
    .trustbar__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
