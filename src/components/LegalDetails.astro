---
import { legalSections } from "../data/site";
---

<div class="legal" data-ps="src/components/LegalDetails.astro:zewmuk">
  {/* TODO: Alle Rechtsangaben sind Platzhalter und müssen vor
      Veröffentlichung vervollständigt und geprüft werden (siehe README). */}
  {
    legalSections.map((section, __psIdx) => (
      <details class="legal__details" id={section.id}>
        <summary class="legal__summary">{section.title}</summary>
        <div class="legal__body" data-ps={`src/components/LegalDetails.astro:zewmul-${__psIdx}`}>
          {section.paragraphs.map((paragraph, __psIdx2) => (
            <p data-ps={`src/components/LegalDetails.astro:oml9rh-${__psIdx2}`}>{paragraph}</p>
          ))}
        </div>
      </details>
    ))
  }
</div>

<style>
  .legal {
    display: grid;
    gap: 0.75rem;
  }

  .legal__details {
    border: 1px solid rgb(255 255 255 / 0.15);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .legal__summary {
    display: flex;
    align-items: center;
    min-height: 52px;
    padding: 0.9rem 1.15rem;
    font-weight: 700;
    color: var(--color-white);
    cursor: pointer;
    list-style: none;
  }

  .legal__summary::after {
    content: "+";
    margin-inline-start: auto;
    font-size: 1.25rem;
    color: var(--color-gold-500);
  }

  .legal__details[open] .legal__summary::after {
    content: "–";
  }

  .legal__summary:hover {
    background: rgb(255 255 255 / 0.05);
  }

  .legal__body {
    display: grid;
    gap: 0.75rem;
    padding: 0 1.15rem 1.25rem;
    font-size: 0.88rem;
    color: rgb(255 255 255 / 0.7);
    scroll-margin-block-start: var(--header-offset);
  }
</style>
