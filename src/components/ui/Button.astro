---
import Icon from "./Icon.astro";

interface Props {
  href: string;
  variant?: "primary" | "outline" | "light";
  size?: "md" | "lg";
  arrow?: boolean;
  class?: string;
  external?: boolean;
  [key: string]: unknown;
}

const {
  href,
  variant = "primary",
  size = "md",
  arrow = false,
  class: className,
  external = false,
  ...rest
} = Astro.props;
---

<a
  href={href}
  class:list={["btn", `btn--${variant}`, `btn--${size}`, className]}
  {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
  {...rest}
 data-ps="src/components/ui/Button.astro:l3shi3">
  <slot />
  {arrow && <Icon name="arrow-right" size={18} />}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius);
    border: 1px solid transparent;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
    text-align: center;
    min-height: 44px;
  }

  .btn--md {
    padding: 0.7rem 1.4rem;
    font-size: 0.95rem;
  }

  .btn--lg {
    padding: 0.95rem 1.9rem;
    font-size: 1.05rem;
  }

  .btn--primary {
    background: var(--color-emerald-600);
    color: var(--color-white);
    box-shadow: 0 2px 8px rgb(22 122 66 / 0.28);
  }

  .btn--primary:hover {
    background: var(--color-emerald-700);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgb(22 122 66 / 0.32);
  }

  .btn--outline {
    background: transparent;
    color: var(--color-navy-900);
    border-color: var(--color-border);
  }

  .btn--outline:hover {
    border-color: var(--color-navy-800);
    background: var(--color-blue-50);
  }

  .btn--light {
    background: var(--color-white);
    color: var(--color-navy-900);
  }

  .btn--light:hover {
    background: var(--color-blue-50);
    transform: translateY(-1px);
  }
</style>
