---
interface Props {
  overline?: string;
  title: string;
  lead?: string;
  align?: "left" | "center";
}

const { overline, title, lead, align = "center" } = Astro.props;
---

<div class:list={["heading", `heading--${align}`]} data-ps="src/components/ui/SectionHeading.astro:a92nve">
  {overline && <p class="heading__overline" data-ps="src/components/ui/SectionHeading.astro:tv1m8q">{overline}</p>}
  <h2 class="heading__title" data-ps="src/components/ui/SectionHeading.astro:orsuwv">{title}</h2>
  {lead && <p class="heading__lead">{lead}</p>}
</div>

<style>
  .heading {
    max-width: 42rem;
    margin-block-end: clamp(2rem, 4vw, 3rem);
  }

  .heading--center {
    margin-inline: auto;
    text-align: center;
  }

  .heading__overline {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold-600);
    margin-block-end: 0.75rem;
  }

  .heading__overline::before {
    content: "";
    width: 1.75rem;
    height: 2px;
    background: var(--color-gold-500);
    border-radius: 2px;
  }

  .heading--center .heading__overline::after {
    content: "";
    width: 1.75rem;
    height: 2px;
    background: var(--color-gold-500);
    border-radius: 2px;
  }

  .heading__lead {
    margin-block-start: 0.9rem;
    font-size: 1.1rem;
    color: var(--color-text-muted);
  }

  .heading--center .heading__lead {
    margin-inline: auto;
  }
</style>
