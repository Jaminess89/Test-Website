---
/**
 * Einheitlicher Premium-Bilderrahmen für lokale SVG-Platzhalter
 * und spätere echte Fotos.
 */
interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  ratio?: string;
  eager?: boolean;
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  ratio = "4 / 3",
  eager = false,
  class: className,
} = Astro.props;
---

<figure class:list={["frame", className]}>
  <img
    src={src}
    alt="Servicetechniker von Rauchmelder Express prüft mit einem Tablet einen Rauchwarnmelder in einer hellen Mietwohnung"
    width={width}
    height={height}
    style={`aspect-ratio: ${ratio};`}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    {...(eager ? { fetchpriority: "high" } : {})} data-ps="src/components/ui/PictureFrame.astro:ibuuik" />
</figure>

<style>
  .frame {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border-premium);
    box-shadow: var(--shadow-md);
    background: var(--color-blue-50);
  }

  .frame::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.35);
    pointer-events: none;
  }

  .frame img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }
</style>
