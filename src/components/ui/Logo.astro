---
import { brand } from "../../data/site";

interface Props {
  light?: boolean;
  compact?: boolean;
}

const { light = false, compact = false } = Astro.props;
---

<a href="#start" class:list={["logo", { "logo--light": light }]} aria-label={`${brand.name} – zum Seitenanfang`} data-ps="src/components/ui/Logo.astro:jqzvoo">
  <span class="logo__mark" aria-hidden="true" data-ps="src/components/ui/Logo.astro:7fy981">
    <svg viewBox="0 0 40 40" width="40" height="40" fill="none">
      <circle cx="20" cy="20" r="19" class="logo__ring" stroke-width="2" />
      <circle cx="20" cy="17" r="7.5" class="logo__detector" stroke-width="2" />
      <circle cx="20" cy="17" r="2.2" class="logo__dot" />
      <path d="M13 27.5c2.4 2 4.6 3 7 3s4.6-1 7-3" class="logo__wave" stroke-width="2" stroke-linecap="round" />
    </svg>
  </span>
  <span class="logo__text" data-ps="src/components/ui/Logo.astro:7fy982">
    <span class="logo__name" data-ps="src/components/ui/Logo.astro:7fy983">{brand.name}</span>
    {!compact && <span class="logo__descriptor" data-ps="src/components/ui/Logo.astro:7fy984">{brand.descriptor}</span>}
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--color-navy-900);
  }

  .logo__mark {
    flex-shrink: 0;
    display: inline-flex;
  }

  .logo__ring {
    stroke: var(--color-gold-500);
  }

  .logo__detector {
    stroke: currentColor;
  }

  .logo__dot {
    fill: var(--color-emerald-600);
  }

  .logo__wave {
    stroke: var(--color-emerald-600);
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .logo__name {
    font-weight: 800;
    font-size: 1.12rem;
    letter-spacing: -0.02em;
  }

  .logo__descriptor {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold-600);
  }

  .logo--light {
    color: var(--color-white);
  }

  .logo--light .logo__descriptor {
    color: var(--color-gold-500);
  }
</style>
