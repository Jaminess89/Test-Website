---
import { benefits } from "../data/site";
import Container from "./ui/Container.astro";
import SectionHeading from "./ui/SectionHeading.astro";
import Icon from "./ui/Icon.astro";
---

<section class="section" id="vorteile">
  <Container>
    <SectionHeading title="Weniger Aufwand. Mehr Überblick." />
    <ul class="grid" role="list">
      {
        benefits.map((benefit) => (
          <li class="tile">
            <span class="tile__icon">
              <Icon name={benefit.icon} size={26} />
            </span>
            <h3 class="tile__title">{benefit.title}</h3>
            <p class="tile__text">{benefit.text}</p>
          </li>
        ))
      }
    </ul>
  </Container>
</section>

<style>
  .section {
    padding-block: var(--section-space);
    background: var(--color-navy-900);
  }

  .section :global(.heading__title) {
    color: var(--color-white);
  }

  .grid {
    display: grid;
    gap: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.9rem;
    background: rgb(255 255 255 / 0.04);
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: var(--radius-lg);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .tile:hover {
    transform: translateY(-3px);
    border-color: rgb(184 154 91 / 0.55);
  }

  .tile__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: var(--radius);
    background: rgb(184 154 91 / 0.14);
    border: 1px solid rgb(184 154 91 / 0.4);
    color: var(--color-gold-500);
  }

  .tile__title {
    color: var(--color-white);
    font-size: 1.1rem;
  }

  .tile__text {
    color: rgb(255 255 255 / 0.75);
    font-size: 0.95rem;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
