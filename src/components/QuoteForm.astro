---
import { serviceOptions, districtOptions } from "../data/site";
import Container from "./ui/Container.astro";
import SectionHeading from "./ui/SectionHeading.astro";
import Icon from "./ui/Icon.astro";

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? "";
const trustPoints = [
  "Unverbindliche Anfrage",
  "Keine automatische Beauftragung",
  "Persönlicher Ansprechpartner",
];
---

<section class="section" id="angebot">
  <Container>
    <div class="panel">
      <SectionHeading
        overline="Unverbindlich anfragen"
        title="Ihr Festpreis-Angebot"
        lead="Wenige Angaben genügen für eine persönliche Einschätzung."
      />

      <div
        class="form-status"
        id="form-status"
        role="alert"
        tabindex="-1"
        hidden
        data-form-status
      ></div>

      <form
        class="form"
        method="post"
        action={endpoint || "#angebot"}
        novalidate
        data-quote-form
        data-endpoint={endpoint}
      >
        <div class="field">
          <label for="leistung">Leistung <span aria-hidden="true">*</span></label>
          <select id="leistung" name="leistung" required>
            <option value="">Bitte wählen</option>
            {serviceOptions.map((option) => <option value={option}>{option}</option>)}
          </select>
          <p class="field__error" id="leistung-error" hidden>Bitte wählen Sie eine Leistung.</p>
        </div>

        <div class="field">
          <label for="bezirk">Berliner Bezirk</label>
          <select id="bezirk" name="bezirk">
            <option value="">Bitte wählen (optional)</option>
            {districtOptions.map((option) => <option value={option}>{option}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="plz">Postleitzahl <span aria-hidden="true">*</span></label>
          <input
            id="plz"
            name="plz"
            type="text"
            inputmode="numeric"
            pattern="[0-9]{5}"
            maxlength="5"
            autocomplete="postal-code"
            required
          />
          <p class="field__error" id="plz-error" hidden>Bitte geben Sie eine fünfstellige PLZ ein.</p>
        </div>

        <div class="field">
          <label for="wohnungen">Anzahl der Wohnungen <span aria-hidden="true">*</span></label>
          <input
            id="wohnungen"
            name="wohnungen"
            type="number"
            min="1"
            max="9999"
            inputmode="numeric"
            required
          />
          <p class="field__error" id="wohnungen-error" hidden>Bitte geben Sie die Anzahl der Wohnungen an.</p>
        </div>

        <div class="field">
          <label for="name">Name <span aria-hidden="true">*</span></label>
          <input id="name" name="name" type="text" autocomplete="name" required />
          <p class="field__error" id="name-error" hidden>Bitte geben Sie Ihren Namen an.</p>
        </div>

        <div class="field">
          <label for="email">E-Mail</label>
          <input id="email" name="email" type="email" autocomplete="email" aria-describedby="contact-error" />
          <p class="field__error" id="email-error" hidden>Bitte geben Sie eine gültige E-Mail-Adresse ein.</p>
        </div>

        <div class="field">
          <label for="telefon">Telefonnummer</label>
          <input id="telefon" name="telefon" type="tel" autocomplete="tel" aria-describedby="contact-error" />
        </div>

        <div class="field field--full">
          <p class="field__error" id="contact-error" hidden>
            Bitte geben Sie mindestens eine Kontaktmöglichkeit an: E-Mail oder Telefonnummer.
          </p>
        </div>

        <div class="field field--full">
          <label for="nachricht">Nachricht <span class="field__optional">(optional)</span></label>
          <textarea id="nachricht" name="nachricht" rows="4"></textarea>
        </div>

        {/* Honeypot-Feld gegen Spam (für Menschen unsichtbar) */}
        <div class="field field--hp" aria-hidden="true">
          <label for="firma-hp">Firma</label>
          <input id="firma-hp" name="firma" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="field field--full form__actions">
          <button type="submit" class="submit" data-submit-button>
            <span data-submit-label>Kostenloses Festpreis-Angebot erhalten</span>
          </button>
          <ul class="form__trust" role="list">
            {
              trustPoints.map((point) => (
                <li>
                  <Icon name="check" size={15} />
                  {point}
                </li>
              ))
            }
          </ul>
        </div>
      </form>
    </div>
  </Container>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-quote-form]");
  const statusBox = document.querySelector<HTMLElement>("[data-form-status]");

  if (form && statusBox) {
    const endpoint = form.dataset.endpoint ?? "";
    const submitButton = form.querySelector<HTMLButtonElement>("[data-submit-button]");
    const submitLabel = form.querySelector<HTMLElement>("[data-submit-label]");

    const fields: Array<{ id: string; validate: (el: HTMLInputElement | HTMLSelectElement) => boolean }> = [
      { id: "leistung", validate: (el) => el.value.trim() !== "" },
      { id: "plz", validate: (el) => /^[0-9]{5}$/.test(el.value.trim()) },
      { id: "wohnungen", validate: (el) => Number(el.value) >= 1 },
      { id: "name", validate: (el) => el.value.trim().length >= 2 },
      {
        id: "email",
        validate: (el) => el.value.trim() === "" || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value.trim()),
      },
    ];

    const getField = (id: string) =>
      document.getElementById(id) as HTMLInputElement | HTMLSelectElement | null;

    const setFieldState = (id: string, valid: boolean) => {
      const field = getField(id);
      const error = document.getElementById(`${id}-error`);
      if (!field) return;
      field.setAttribute("aria-invalid", String(!valid));
      if (valid) {
        field.removeAttribute("aria-describedby");
        if (error) error.hidden = true;
      } else if (error) {
        error.hidden = false;
        field.setAttribute("aria-describedby", error.id);
      }
    };

    const validateContact = () => {
      const email = getField("email");
      const phone = getField("telefon");
      const contactError = document.getElementById("contact-error");
      const valid = Boolean(email?.value.trim() || phone?.value.trim());
      if (contactError) contactError.hidden = valid;
      email?.setAttribute("aria-invalid", String(!valid && !email.value.trim()));
      phone?.setAttribute("aria-invalid", String(!valid && !phone.value.trim()));
      return valid;
    };

    const showStatus = (type: "error" | "success" | "info", message: string) => {
      statusBox.hidden = false;
      statusBox.textContent = message;
      statusBox.classList.remove("form-status--error", "form-status--success", "form-status--info");
      statusBox.classList.add(`form-status--${type}`);
      statusBox.focus();
    };

    fields.forEach(({ id, validate }) => {
      getField(id)?.addEventListener("blur", () => {
        const field = getField(id);
        if (field) setFieldState(id, validate(field));
      });
    });

    getField("email")?.addEventListener("input", validateContact);
    getField("telefon")?.addEventListener("input", validateContact);

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      let firstInvalid: string | null = null;
      fields.forEach(({ id, validate }) => {
        const field = getField(id);
        if (!field) return;
        const valid = validate(field);
        setFieldState(id, valid);
        if (!valid && !firstInvalid) firstInvalid = id;
      });

      const contactValid = validateContact();
      if (!contactValid && !firstInvalid) firstInvalid = "email";

      if (firstInvalid) {
        showStatus("error", "Bitte prüfen Sie die markierten Felder.");
        getField(firstInvalid)?.focus();
        return;
      }

      if (!endpoint) {
        // Demo-Modus: kein echter Versand konfiguriert
        showStatus(
          "info",
          "Demo-Modus: Es ist noch kein Formular-Endpunkt konfiguriert. Ihre Eingaben wurden geprüft, aber nicht versendet. Richten Sie PUBLIC_FORM_ENDPOINT ein, um Anfragen zu empfangen."
        );
        return;
      }

      if (submitButton) submitButton.disabled = true;
      if (submitLabel) submitLabel.textContent = "Wird gesendet …";
      statusBox.hidden = true;

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });

        if (!response.ok) throw new Error(`HTTP ${response.status}`);

        form.reset();
        showStatus(
          "success",
          "Vielen Dank für Ihre Anfrage. Wir melden uns persönlich bei Ihnen."
        );
      } catch {
        showStatus(
          "error",
          "Ihre Anfrage konnte leider nicht gesendet werden. Bitte versuchen Sie es erneut oder rufen Sie uns an."
        );
      } finally {
        if (submitButton) submitButton.disabled = false;
        if (submitLabel) submitLabel.textContent = "Kostenloses Festpreis-Angebot erhalten";
      }
    });
  }
</script>

<style>
  .section {
    padding-block: var(--section-space);
    background:
      linear-gradient(180deg, var(--color-navy-950) 0%, var(--color-navy-900) 100%);
  }

  .panel {
    max-width: 52rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--color-white);
    border: 1px solid var(--color-border-premium);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .form-status {
    margin-block-end: 1.5rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius);
    font-weight: 600;
  }

  .form-status--error {
    background: var(--color-error-bg);
    color: var(--color-error);
    border: 1px solid rgb(180 35 24 / 0.3);
  }

  .form-status--success {
    background: var(--color-emerald-50);
    color: var(--color-emerald-700);
    border: 1px solid rgb(22 122 66 / 0.3);
  }

  .form-status--info {
    background: var(--color-blue-50);
    color: var(--color-navy-800);
    border: 1px solid var(--color-border);
  }

  .form {
    display: grid;
    gap: 1.15rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field label {
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--color-navy-900);
  }

  .field label span[aria-hidden="true"] {
    color: var(--color-emerald-700);
  }

  .field__optional {
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-white);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .field textarea {
    min-height: 6rem;
    resize: vertical;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: var(--color-emerald-600);
    outline: none;
    box-shadow: 0 0 0 3px rgb(32 155 82 / 0.18);
  }

  .field [aria-invalid="true"] {
    border-color: var(--color-error);
  }

  .field__error {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-error);
  }

  .field--hp {
    position: absolute;
    inset-inline-start: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__actions {
    align-items: center;
    gap: 1rem;
    margin-block-start: 0.5rem;
  }

  .submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 54px;
    padding: 0.9rem 1.5rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--color-emerald-600);
    color: var(--color-white);
    font-size: 1.05rem;
    font-weight: 700;
    box-shadow: 0 2px 10px rgb(22 122 66 / 0.3);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .submit:hover:not(:disabled) {
    background: var(--color-emerald-700);
    transform: translateY(-1px);
  }

  .submit:disabled {
    opacity: 0.65;
    cursor: wait;
  }

  .form__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .form__trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .form__trust :global(svg) {
    color: var(--color-emerald-600);
  }

  @media (min-width: 700px) {
    .form {
      grid-template-columns: repeat(2, 1fr);
    }

    .field--full,
    .form__actions {
      grid-column: 1 / -1;
    }
  }
</style>
