---
import { faqItems } from "../data/site";
import Container from "./ui/Container.astro";
import SectionHeading from "./ui/SectionHeading.astro";
import Icon from "./ui/Icon.astro";
---

<section class="section" id="faq" data-ps="src/components/FAQ.astro:cvmgkv">
  <Container>
    <SectionHeading title="Häufige Fragen" />
    <div class="list" data-faq-list data-ps="src/components/FAQ.astro:frt6be">
      {
        faqItems.map((item, index) => (
          <div class="item" data-ps={`src/components/FAQ.astro:frt6bf-${index}`}>
            <h3 class="item__heading" data-ps={`src/components/FAQ.astro:clqf0g-${index}`}>
              <button
                type="button"
                class="item__button"
                aria-expanded={index === 0 ? "true" : "false"}
                aria-controls={`faq-panel-${index}`}
                id={`faq-button-${index}`}
               data-ps={`src/components/FAQ.astro:i93d0k-${index}`}>
                <span data-ps={`src/components/FAQ.astro:58ely5-${index}`}>{item.question}</span>
                <span class="item__chevron" data-ps={`src/components/FAQ.astro:58ely6-${index}`}>
                  <Icon name="chevron-down" size={20} />
                </span>
              </button>
            </h3>
            <div
              class="item__panel"
              id={`faq-panel-${index}`}
              role="region"
              aria-labelledby={`faq-button-${index}`}
              hidden={index !== 0}
             data-ps={`src/components/FAQ.astro:frt6bg-${index}`}>
              <p class="item__answer" data-ps={`src/components/FAQ.astro:xe7y1-${index}`}>{item.answer}</p>
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</section>

<script>
  const list = document.querySelector<HTMLElement>("[data-faq-list]");

  list?.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".item__button");
    if (!button) return;

    const isOpen = button.getAttribute("aria-expanded") === "true";

    // Nur ein Eintrag gleichzeitig geöffnet
    list.querySelectorAll<HTMLButtonElement>(".item__button").forEach((other) => {
      other.setAttribute("aria-expanded", "false");
      const panel = document.getElementById(other.getAttribute("aria-controls") ?? "");
      if (panel) panel.hidden = true;
    });

    if (!isOpen) {
      button.setAttribute("aria-expanded", "true");
      const panel = document.getElementById(button.getAttribute("aria-controls") ?? "");
      if (panel) panel.hidden = false;
    }
  });
</script>

<style>
  .section {
    padding-block: var(--section-space);
    background: var(--color-white);
  }

  .list {
    display: grid;
    gap: 0.75rem;
    max-width: 46rem;
    margin-inline: auto;
  }

  .item {
    background: var(--color-ivory);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .item:has(.item__button[aria-expanded="true"]) {
    border-color: var(--color-gold-500);
  }

  .item__heading {
    margin: 0;
  }

  .item__button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    min-height: 56px;
    padding: 1rem 1.25rem;
    background: transparent;
    border: 0;
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-navy-900);
    text-align: start;
  }

  .item__chevron {
    flex-shrink: 0;
    display: inline-flex;
    color: var(--color-gold-600);
    transition: transform 0.2s ease;
  }

  .item__button[aria-expanded="true"] .item__chevron {
    transform: rotate(180deg);
  }

  .item__answer {
    padding: 0 1.25rem 1.25rem;
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .item__chevron {
      transition: none;
    }
  }
</style>
