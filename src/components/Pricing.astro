---
import { pricingItems, priceFactors } from "../data/site";
import Container from "./ui/Container.astro";
import SectionHeading from "./ui/SectionHeading.astro";
import CheckList from "./ui/CheckList.astro";
import Button from "./ui/Button.astro";
import Icon from "./ui/Icon.astro";
---

<section class="section" id="preise" data-ps="src/components/Pricing.astro:z5nod9">
  <Container>
    <SectionHeading title="Klare Angebote statt Überraschungen" />
    <ul class="grid" role="list">
      {
        pricingItems.map((item, __psIdx) => (
          <li class="card" data-ps={`src/components/Pricing.astro:yy5wct-${__psIdx}`}>
            <h3 class="card__title" data-ps={`src/components/Pricing.astro:mtxtf3-${__psIdx}`}>{item.title}</h3>
            <CheckList items={item.items} />
            <p class="card__note" data-ps={`src/components/Pricing.astro:4vhc6v-${__psIdx}`}>{item.note}</p>
          </li>
        ))
      }
    </ul>

    <div class="factors" data-ps="src/components/Pricing.astro:dt5mr8">
      <h3 class="factors__title" data-ps="src/components/Pricing.astro:mtxtf2">Davon hängt Ihr Angebot ab</h3>
      <ul class="factors__list" role="list">
        {
          priceFactors.map((factor, __psIdx) => (
            <li class="factors__item" data-ps={`src/components/Pricing.astro:yy5wcu-${__psIdx}`}>
              <Icon name="check" size={16} />
              {factor}
            </li>
          ))
        }
      </ul>
      <p class="factors__hint" data-ps="src/components/Pricing.astro:4vhc6u">Sie erhalten vor der Beauftragung ein konkretes Angebot.</p>
      <Button href="#angebot" arrow>Festpreis anfragen</Button>
    </div>
  </Container>
</section>

<style>
  .section {
    padding-block: var(--section-space);
    background: var(--color-white);
  }

  .grid {
    display: grid;
    gap: 1.5rem;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.8rem;
    background: var(--color-blue-50);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .card__note {
    margin-block-start: auto;
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--color-border);
    font-weight: 700;
    color: var(--color-navy-900);
  }

  .factors {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    margin-block-start: 3rem;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    background: var(--color-ivory);
    border: 1px solid var(--color-border-premium);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .factors__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.75rem;
    padding: 0;
    list-style: none;
  }

  .factors__item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--color-navy-900);
  }

  .factors__item :global(svg) {
    color: var(--color-emerald-600);
  }

  .factors__hint {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-navy-900);
  }

  @media (min-width: 850px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
