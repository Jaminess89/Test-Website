---
import { processSteps } from "../data/site";
import Container from "./ui/Container.astro";
import SectionHeading from "./ui/SectionHeading.astro";
import Button from "./ui/Button.astro";
---

<section class="section" id="ablauf" data-ps="src/components/ProcessSteps.astro:37b0wl">
  <Container>
    <SectionHeading title="In drei Schritten erledigt" />
    <ol class="steps" role="list">
      {
        processSteps.map((step, index) => (
          <li class="step" data-ps={`src/components/ProcessSteps.astro:em6m7z-${index}`}>
            <span class="step__number" aria-hidden="true" data-ps={`src/components/ProcessSteps.astro:82g10e-${index}`}>
              {index + 1}
            </span>
            <h3 class="step__title" data-ps={`src/components/ProcessSteps.astro:1d6a0s-${index}`}>{step.title}</h3>
            <p class="step__text" data-ps={`src/components/ProcessSteps.astro:lmp5s3-${index}`}>{step.text}</p>
            <Button
              href="#angebot"
              variant="outline"
              class="step__button"
              data-ps={`src/components/ProcessSteps.astro:button-${index}`}
            >
              {step.buttonLabel}
            </Button>
          </li>
        ))
      }
    </ol>
  </Container>
</section>

<style>
  .section {
    padding-block: var(--section-space);
    background: var(--color-white);
  }

  .steps {
    display: grid;
    gap: 2.25rem;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    text-align: center;
    padding-inline: 1rem;
  }

  .step__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.25rem;
    height: 4.25rem;
    border-radius: 50%;
    background: var(--color-white);
    border: 2px solid var(--color-gold-500);
    color: var(--color-navy-900);
    font-size: 1.5rem;
    font-weight: 800;
    box-shadow: var(--shadow-sm);
  }

  .step__title {
    font-size: 1.15rem;
  }

  .step__text {
    color: var(--color-text-muted);
    max-width: 22rem;
    margin-bottom: 0.5rem;
  }

  .step__button {
    margin-top: auto;
    width: 100%;
    max-width: 180px;
  }

  @media (min-width: 800px) {
    .steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    /* Verbindungslinie zwischen den Nummern, ohne Inhalte zu kreuzen */
    .step:not(:last-child)::after {
      content: "";
      position: absolute;
      inset-block-start: 2.1rem;
      inset-inline-start: calc(50% + 2.75rem);
      width: calc(100% - 5.5rem);
      border-block-start: 2px dashed var(--color-border-premium);
    }
  }
</style>
