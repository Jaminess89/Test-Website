---
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';
---

<style>
  /* Versteckt die Scrollbar, erhält aber die Scrollfunktion */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* Logo Styles */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: transparent;
  }
  .detector-box {
    position: relative;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
  }
  .detector-box svg.detector-svg {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
  }
  .detector-box .check {
    position: absolute;
    right: -4px;
    bottom: -2px;
    width: 18px;
    height: 18px;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.4));
  }
  .detector-box .check .mark {
    fill: url(#logo-checkGreen);
    stroke: #0a101d;
    stroke-width: 14;
    stroke-linejoin: round;
    paint-order: stroke fill;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    line-height: 1.1;
  }
  .brand-title {
    font-family: var(--font-heading, sans-serif);
    font-size: 16px;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .brand-subline {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: #63c62f;
    text-transform: uppercase;
    white-space: nowrap;
    margin-top: 2px;
  }

  /* Scrolled State */
  #navbar.is-scrolled {
    background-color: rgba(10, 15, 25, 0.96);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }
</style>

<header id="navbar" class="fixed top-0 left-0 right-0 w-full z-50 bg-[rgba(6,43,74,0.8)] border-b border-white/10 transition-all duration-300 shadow-md">
  <nav class="h-[68px] flex items-center">
    <Container class="flex justify-between items-center w-full !pl-2 sm:!pl-3 md:!pl-4">

      {/* Logo / Brand */}
      <a href="/" class="nav-logo flex items-center no-underline shrink-0 mr-2 sm:mr-4 md:mr-6 py-2" aria-label="DGUV V3 Prüfung Berlin Startseite">
        <span class="detector-box" aria-hidden="true">
          <svg class="detector-svg" viewBox="0 0 48 48">
            <defs>
              <linearGradient id="logo-boltGreen" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#8ef05a" />
                <stop offset="100%" stop-color="#2fae3f" />
              </linearGradient>
              <linearGradient id="logo-boxBlue" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#1d4e79" />
                <stop offset="100%" stop-color="#0a2c49" />
              </linearGradient>
            </defs>
            <rect x="3" y="3" width="42" height="42" rx="12" fill="url(#logo-boxBlue)" stroke="rgba(255,255,255,0.25)" stroke-width="1.5" />
            <path d="M26.5 9 15 27h7.5L20.5 39 33 21h-7.5Z" fill="url(#logo-boltGreen)" />
          </svg>
          <svg class="check" viewBox="0 0 48 48">
            <defs>
              <linearGradient id="logo-checkGreen" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#8ef05a" />
                <stop offset="100%" stop-color="#20bf50" />
              </linearGradient>
            </defs>
            <path class="mark" d="M10 26l9 9 19-22" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="10" />
          </svg>
        </span>
        <span class="brand-text">
          <span class="brand-title">DGUV V3 Prüfung Berlin</span>
          <span class="brand-subline">E-Check nach VDE · BGV A3</span>
        </span>
      </a>

      {/* Menu items: Single row, swipeable on mobile — Anker zu den Sektionen */}
      <div class="flex items-center overflow-x-auto no-scrollbar scroll-smooth whitespace-nowrap py-1 px-1 shrink min-w-0 w-full md:w-auto justify-between sm:justify-around md:justify-start">
        <div class="flex flex-nowrap gap-1.5 sm:gap-3 md:gap-5 lg:gap-7 items-center text-[12px] sm:text-[13px] lg:text-[14px]">
          <a href="/#pflicht" class="px-2.5 py-1 font-bold text-white/90 uppercase no-underline hover:text-[#63c62f] transition-colors shrink-0 whitespace-nowrap">Pflicht</a>
          <a href="/#risiken" class="px-2.5 py-1 font-bold text-white/90 uppercase no-underline hover:text-[#63c62f] transition-colors shrink-0 whitespace-nowrap">Risiken + Vorteile</a>
          <a href="/#dguv-v3" class="px-2.5 py-1 font-bold text-white/90 uppercase no-underline hover:text-[#63c62f] transition-colors shrink-0 whitespace-nowrap">Was ist DGUV V3?</a>
          <a href="/#pruefumfang" class="px-2.5 py-1 font-bold text-white/90 uppercase no-underline hover:text-[#63c62f] transition-colors shrink-0 whitespace-nowrap">Prüfumfang</a>
          <a href="/#prueffristen" class="px-2.5 py-1 font-bold text-white/90 uppercase no-underline hover:text-[#63c62f] transition-colors shrink-0 whitespace-nowrap">Prüffristen</a>
          <a href="/#warum-wir" class="px-2.5 py-1 font-bold text-white/90 uppercase no-underline hover:text-[#63c62f] transition-colors shrink-0 whitespace-nowrap">Warum wir</a>
        </div>
      </div>

      {/* Buttons: Hidden on mobile (md breakpoint = tablet and up) */}
      <div class="hidden md:flex items-center gap-2.5 lg:gap-3.5 shrink-0 pl-3 lg:pl-6">
        <a
          href="/#angebot"
          class="inline-flex items-center justify-center text-white text-[13.5px] lg:text-[14.5px] font-black px-4 py-2 rounded-full no-underline transition-all duration-200 border-[1.5px] border-[rgba(103,235,66,0.9)] bg-gradient-to-b from-[rgba(49,184,54,0.75)] to-[rgba(16,137,41,0.7)] backdrop-blur-md shadow-[inset_0_1px_0_rgba(255,255,255,0.25),0_0_12px_rgba(66,230,49,0.3)] hover:brightness-110 hover:-translate-y-0.5 whitespace-nowrap"
        >Unverbindliches Angebot</a>
        <a
          href="tel:+493020007607"
          class="inline-flex items-center gap-2 text-white border-[1.5px] border-[rgba(190,211,225,0.4)] bg-gradient-to-b from-[rgba(70,104,132,0.4)] to-[rgba(36,71,100,0.35)] text-[13.5px] lg:text-[14.5px] font-black px-3.5 py-1.5 rounded-full no-underline backdrop-blur-md transition-all duration-200 shadow-[inset_0_1px_rgba(255,255,255,0.12)] hover:border-[rgba(214,230,241,0.55)] hover:-translate-y-0.5 whitespace-nowrap"
        >
          <span class="w-6 h-6 rounded-full flex items-center justify-center bg-[rgba(132,164,190,0.25)] border border-white/10 shrink-0" aria-hidden="true">
            <svg viewBox="0 0 48 48" class="w-3.5 h-3.5 stroke-white fill-none" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 7 8 11c-2 2 1 11 8 19s16 12 19 10l5-6-10-7-5 5c-5-3-9-7-11-12l5-4z"/>
            </svg>
          </span>
          <span class="whitespace-nowrap">030 20007607</span>
        </a>
      </div>

    </Container>
  </nav>
</header>

<script is:inline>
  const nav = document.getElementById('navbar');
  if (nav) {
    const handleScroll = () => {
      if (window.scrollY > 20) {
        nav.classList.add('is-scrolled');
      } else {
        nav.classList.remove('is-scrolled');
      }
    };
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  const NAV_GAP = 14;

  function scrollToSectionHeading(hash) {
    const id = (hash || '').replace(/^#/, '');
    if (!id) return false;
    const el = document.getElementById(id);
    if (!el) return false;

    // Wenn das Element selbst eine Überschrift oder die Formular-Karte ist, dieses nehmen, sonst die erste Überschrift darin
    let target = el;
    if (!el.matches('h1, h2, h3, .card')) {
      const heading = el.querySelector('h1, h2, h3');
      if (heading) target = heading;
    }

    const navH = nav ? nav.offsetHeight : 68;
    const top = target.getBoundingClientRect().top + window.pageYOffset - navH - NAV_GAP;
    window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
    return true;
  }

  document.addEventListener('click', (e) => {
    const link = e.target.closest('a[href]');
    if (!link) return;
    const href = link.getAttribute('href') || '';
    if (!href.includes('#')) return;
    let url;
    try { url = new URL(href, window.location.href); } catch { return; }
    if (url.pathname !== window.location.pathname) return;
    if (!url.hash) return;
    if (scrollToSectionHeading(url.hash)) {
      e.preventDefault();
      history.pushState(null, '', url.hash);
    }
  });

  window.addEventListener('load', () => {
    if (window.location.hash) {
      requestAnimationFrame(() => scrollToSectionHeading(window.location.hash));
    }
  });
</script>
